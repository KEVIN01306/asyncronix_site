---
const { module, lang } = Astro.props;
---

<section class="py-24 bg-white dark:bg-slate-900 relative overflow-hidden transition-colors duration-300">
  <div class="max-w-7xl mx-auto px-6">
    <!-- Header Section -->
    <div class="text-center max-w-4xl mx-auto mb-12">
      <a
        href={`/${lang}/modules`}
        class="inline-flex items-center justify-center gap-2 text-slate-500 dark:text-slate-400 hover:text-[var(--color-primary)] dark:hover:text-[var(--color-primary)] mb-8 transition-colors font-medium text-sm uppercase tracking-wider"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"><path d="m15 18-6-6 6-6"></path></svg
        >
        Volver a módulos
      </a>

      <h1
        class="text-5xl md:text-6xl font-extrabold text-slate-900 dark:text-white tracking-tight mb-6"
      >
        {module.name}
      </h1>
      <p class="text-xl md:text-2xl text-slate-600 dark:text-slate-400 leading-relaxed">
        {module.description}
      </p>
    </div>

    <!-- Main Image with Decorative Background -->
    <div class="relative w-full max-w-5xl mx-auto mb-32 group">
      <!-- Decorative background -->
      <div
        class="absolute -inset-4 md:-inset-8 rounded-[3rem] opacity-20 group-hover:opacity-30 transition-opacity duration-500 blur-xl"
        style={`background: ${module.themeColor || "var(--color-primary)"};`}
      >
      </div>
      <div
        class="absolute -inset-2 md:-inset-4 rounded-[2.5rem] opacity-40 group-hover:opacity-50 transition-opacity duration-500"
        style={`background: linear-gradient(135deg, ${module.themeColor || "var(--color-primary)"} 0%, transparent 100%);`}
      >
      </div>

      <!-- Image Container -->
      <div
        class="relative w-full rounded-3xl bg-slate-50 dark:bg-slate-800 border border-slate-200/50 dark:border-slate-700/50 shadow-2xl dark:shadow-slate-900/80 overflow-hidden flex flex-col transition-colors duration-300"
      >
        <!-- Mockup Header -->
        <div
          class="h-10 bg-slate-100/80 dark:bg-slate-800/80 backdrop-blur border-b border-slate-200 dark:border-slate-700 flex items-center px-4 gap-2 shrink-0 z-20"
        >
          <div class="w-3 h-3 rounded-full bg-red-300"></div>
          <div class="w-3 h-3 rounded-full bg-yellow-300"></div>
          <div class="w-3 h-3 rounded-full bg-green-300"></div>
        </div>
        <!-- Image -->
        <div
          class="flex-1 w-full relative bg-white dark:bg-slate-900 flex items-center justify-center p-0 transition-colors duration-300"
        >
          <img
            src={module.image}
            alt={module.name}
            class="w-full h-full object-contain"
          />
        </div>
      </div>
    </div>

    <!-- What's included Section -->
    <div class="max-w-5xl mx-auto mb-32">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-4xl font-bold text-slate-900 dark:text-white mb-4">
          Lo que incluye
        </h2>
        <p class="text-lg text-slate-600 dark:text-slate-400">
          Todo lo que necesitas para potenciar esta área de tu negocio.
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-8">
        <!-- Features -->
        <div
          class="p-8 md:p-10 rounded-3xl bg-white dark:bg-slate-800 border border-slate-100 dark:border-slate-700 shadow-xl shadow-slate-100/50 dark:shadow-slate-900/50 transition-colors duration-300"
        >
          <h3
            class="text-2xl font-bold text-slate-900 dark:text-white mb-8 flex items-center gap-3"
          >
            <svg
              class="w-7 h-7 text-[var(--color-primary)]"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"
              ></path>
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
            </svg>
            Características
          </h3>
          <ul class="flex flex-col gap-5">
            {
              module.features.map((feature: string) => (
                <li class="flex items-start gap-4 text-slate-700 dark:text-slate-300 text-lg">
                  <svg
                    class="w-6 h-6 text-[var(--color-primary)] shrink-0 mt-0.5"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2.5"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M5 13l4 4L19 7"
                    />
                  </svg>
                  <span class="leading-relaxed">{feature}</span>
                </li>
              ))
            }
          </ul>
        </div>

        <!-- Benefits -->
        <div
          class="p-8 md:p-10 rounded-3xl dark:!bg-slate-800 transition-colors duration-300"
          style={`background-color: ${module.themeColor ? module.themeColor + "15" : "var(--color-primary)"} ; border: 1px solid ${module.themeColor ? module.themeColor + "30" : "var(--color-primary)"};`}
        >
          <h3
            class="text-2xl font-bold text-slate-900 dark:text-white mb-8 flex items-center gap-3"
          >
            <svg
              class="w-7 h-7"
              style={`color: ${module.themeColor || "var(--color-primary)"}`}
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M13 10V3L4 14h7v7l9-11h-7z"></path>
            </svg>
            Beneficios clave
          </h3>
          <ul class="flex flex-col gap-5">
            {
              module.benefits.map((benefit: string) => (
                <li class="flex items-start gap-4 text-slate-800 dark:text-slate-200 text-lg">
                  <div
                    class="w-6 h-6 rounded-full flex items-center justify-center shrink-0 mt-0.5"
                    style={`background-color: ${module.themeColor ? module.themeColor + "30" : "var(--color-primary)"}; color: ${module.themeColor || "var(--color-primary)"}`}
                  >
                    <svg
                      class="w-4 h-4"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                      stroke-width="3"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M12 4v16m8-8H4"
                      />
                    </svg>
                  </div>
                  <span class="leading-relaxed font-medium">{benefit}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>

    <!-- Image Collage Section -->
    {
      module.images && module.images.length > 0 && (
        <div class="max-w-6xl mx-auto mb-20">
          <div class="text-center mb-12">
            <h2 class="text-3xl font-bold text-slate-900 dark:text-white mb-4">
              Galería del Módulo
            </h2>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {module.images.map((img: string, idx: number) => {
              // Hacemos que la primera imagen del collage ocupe más espacio si queremos un efecto de masonry,
              // o simplemente una grilla normal.
              const isLarge = idx === 0 && module.images.length % 2 !== 0;
              return (
                <div
                  class={`rounded-3xl overflow-hidden bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 shadow-md dark:shadow-slate-900/50 hover:shadow-xl transition-all duration-300 ${isLarge ? "md:col-span-2 lg:col-span-2 aspect-[16/9]" : "aspect-square md:aspect-video lg:aspect-[4/3]"} group`}
                >
                  <img
                    src={img}
                    alt={`${module.name} - Captura ${idx + 1}`}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out"
                  />
                </div>
              );
            })}
          </div>
        </div>
      )
    }

    <!-- CTA -->
    <div class="text-center mt-12 mb-12">
      <a
        href="https://app.asyncronix.com/register"
        class="inline-flex justify-center items-center gap-3 px-10 py-5 text-xl font-semibold rounded-full text-white shadow-2xl hover:-translate-y-1 transition-all"
        style={`background-color: ${module.themeColor || "var(--color-primary)"}; box-shadow: 0 10px 25px -5px ${module.themeColor ? module.themeColor + "60" : "rgba(0,0,0,0.1)"};`}
      >
        Probar este módulo
        <svg
          class="w-6 h-6"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
        </svg>
      </a>
    </div>
  </div>
</section>
