---
const { module, lang } = Astro.props;
---

<section
  class="py-14 bg-[#f8f9fa] dark:bg-[#0f1318] relative overflow-hidden transition-colors duration-200"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <!-- Header Section -->
    <div class="text-center max-w-4xl mx-auto mb-12">
      <a
        href={`/${lang}/modules`}
        class="inline-flex items-center justify-center gap-1.5 text-xs font-semibold uppercase tracking-wider text-[#5f6368] dark:text-[#9aa0a6] hover:text-[#1a73e8] dark:hover:text-[#8ab4f8] mb-6 transition-colors px-3 py-1.5 rounded-full hover:bg-white dark:hover:bg-[#171d26] border border-transparent hover:border-[#dadce0] dark:hover:border-[#2a3443]"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"><path d="m15 18-6-6 6-6"></path></svg
        >
        Volver al catálogo de módulos
      </a>

      <div class="console-badge mb-3">
        <span>Módulo de Sistema</span>
      </div>

      <h1
        class="text-3xl sm:text-4xl md:text-5xl font-semibold text-[#202124] dark:text-[#f1f3f4] tracking-tight mb-4 font-display"
      >
        {module.name}
      </h1>
      <p
        class="text-base sm:text-xl text-[#5f6368] dark:text-[#9aa0a6] leading-relaxed max-w-2xl mx-auto"
      >
        {module.description}
      </p>
    </div>

    <!-- Main Image inside Console Mockup Frame -->
    <div class="relative w-full max-w-5xl mx-auto mb-20">
      <div
        class="relative w-full rounded-[24px] bg-white dark:bg-[#171d26] border border-[#dadce0] dark:border-[#2a3443] shadow-md dark:shadow-2xl overflow-hidden flex flex-col"
      >
        <!-- Mockup Header -->
        <div
          class="h-10 bg-[#f8f9fa] dark:bg-[#12161f] border-b border-[#dadce0] dark:border-[#2a3443] flex items-center justify-between px-4"
        >
          <div class="flex items-center gap-1.5">
            <div class="w-2.5 h-2.5 rounded-full bg-[#dadce0] dark:bg-[#3c4043]"></div>
            <div class="w-2.5 h-2.5 rounded-full bg-[#dadce0] dark:bg-[#3c4043]"></div>
            <div class="w-2.5 h-2.5 rounded-full bg-[#dadce0] dark:bg-[#3c4043]"></div>
          </div>
          <span class="text-[11px] font-mono text-[#5f6368] dark:text-[#9aa0a6]">asyncronix.com/modules/{module.slug}</span>
          <div class="w-12"></div>
        </div>
        <!-- Image -->
        <div
          class="w-full relative bg-white dark:bg-[#171d26] flex items-center justify-center p-4 sm:p-6"
        >
          <img
            src={module.image}
            alt={module.name}
            class="w-full h-auto object-contain rounded-xl"
          />
        </div>
      </div>
    </div>

    <!-- What's included Section -->
    <div class="max-w-5xl mx-auto mb-20">
      <div class="text-center mb-12">
        <h2
          class="text-2xl sm:text-3xl font-semibold text-[#202124] dark:text-[#f1f3f4] mb-2 font-display"
        >
          Funcionalidades & Beneficios Clave
        </h2>
        <p class="text-sm text-[#5f6368] dark:text-[#9aa0a6]">
          Todo lo necesario para potenciar y automatizar esta área de tu empresa.
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-6">
        <!-- Features -->
        <div
          class="p-6 sm:p-8 rounded-[20px] bg-white dark:bg-[#171d26] border border-[#dadce0] dark:border-[#2a3443] shadow-xs"
        >
          <div class="flex items-center gap-3 mb-6">
            <div class="w-10 h-10 rounded-xl bg-[#e8f0fe] dark:bg-[#1e2634] text-[#1a73e8] dark:text-[#8ab4f8] flex items-center justify-center border border-[#dadce0]/60 dark:border-[#2a3443]">
              <svg
                class="w-5 h-5"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"
                ></path>
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
              </svg>
            </div>
            <h3 class="text-lg font-semibold text-[#202124] dark:text-[#f1f3f4]">
              Características
            </h3>
          </div>
          <ul class="flex flex-col gap-3.5">
            {
              module.features.map((feature: string) => (
                <li class="flex items-start gap-3 text-xs sm:text-sm text-[#3c4043] dark:text-[#c4c7c5]">
                  <svg
                    class="w-4 h-4 text-[#1a73e8] dark:text-[#8ab4f8] shrink-0 mt-0.5"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2.5"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M5 13l4 4L19 7"
                    />
                  </svg>
                  <span class="leading-relaxed font-normal">{feature}</span>
                </li>
              ))
            }
          </ul>
        </div>

        <!-- Benefits -->
        <div
          class="p-6 sm:p-8 rounded-[20px] bg-white dark:bg-[#171d26] border border-[#dadce0] dark:border-[#2a3443] shadow-xs"
        >
          <div class="flex items-center gap-3 mb-6">
            <div class="w-10 h-10 rounded-xl bg-[#e6f4ea] dark:bg-[#188038]/20 text-[#188038] dark:text-[#81c995] flex items-center justify-center border border-[#dadce0]/60 dark:border-[#2a3443]">
              <svg
                class="w-5 h-5"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M13 10V3L4 14h7v7l9-11h-7z"></path>
              </svg>
            </div>
            <h3 class="text-lg font-semibold text-[#202124] dark:text-[#f1f3f4]">
              Beneficios Clave
            </h3>
          </div>
          <ul class="flex flex-col gap-3.5">
            {
              module.benefits.map((benefit: string) => (
                <li class="flex items-start gap-3 text-xs sm:text-sm text-[#3c4043] dark:text-[#c4c7c5]">
                  <div
                    class="w-4 h-4 rounded-full bg-[#e6f4ea] dark:bg-[#188038]/20 text-[#188038] dark:text-[#81c995] flex items-center justify-center shrink-0 mt-0.5"
                  >
                    <svg
                      class="w-2.5 h-2.5"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                      stroke-width="3"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M5 13l4 4L19 7"
                      />
                    </svg>
                  </div>
                  <span class="leading-relaxed font-normal">{benefit}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>

    <!-- Image Collage Section -->
    {
      module.images && module.images.length > 0 && (
        <div class="max-w-6xl mx-auto mb-20">
          <div class="text-center mb-10">
            <h2 class="text-2xl sm:text-3xl font-semibold text-[#202124] dark:text-[#f1f3f4] mb-2 font-display">
              Capturas de la Consola
            </h2>
            <p class="text-xs sm:text-sm text-[#5f6368] dark:text-[#9aa0a6]">Vistas reales de la interfaz del sistema</p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
            {module.images.map((img: string, idx: number) => {
              const isLarge = idx === 0 && module.images.length % 2 !== 0;
              return (
                <div
                  class={`rounded-2xl overflow-hidden bg-white dark:bg-[#171d26] border border-[#dadce0] dark:border-[#2a3443] shadow-xs hover:border-[#1a73e8]/60 transition-all duration-200 ${isLarge ? "md:col-span-2 lg:col-span-2 aspect-[16/9]" : "aspect-square md:aspect-video lg:aspect-[4/3]"} group p-2`}
                >
                  <img
                    src={img}
                    alt={`${module.name} - Captura ${idx + 1}`}
                    class="w-full h-full object-cover rounded-xl group-hover:scale-[1.02] transition-transform duration-300 ease-out"
                  />
                </div>
              );
            })}
          </div>
        </div>
      )
    }

    <!-- CTA -->
    <div class="text-center mt-12 mb-12">
      <a
        href="https://app.asyncronix.com/register"
        class="btn-primary h-11 px-8 text-base"
      >
        Probar este módulo
        <svg
          class="w-4 h-4"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
        </svg>
      </a>
    </div>
  </div>
</section>

