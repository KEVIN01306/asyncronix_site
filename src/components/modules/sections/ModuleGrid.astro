---
const { modules, hero, lang } = Astro.props;
---

<section class="py-16 bg-[#f8f9fa] dark:bg-[#0f1318] relative transition-colors duration-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    
    <!-- Hero Modules Section -->
    <div class="text-center max-w-3xl mx-auto mb-20">
      <div class="console-badge mb-3">
        <span>Catálogo de Soluciones</span>
      </div>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-semibold text-[#202124] dark:text-[#f1f3f4] tracking-tight font-display mb-4">
        {hero.title}
      </h1>
      <p class="text-base sm:text-lg text-[#5f6368] dark:text-[#9aa0a6] leading-relaxed">
        {hero.subtitle}
      </p>
    </div>

    <!-- Stack of Full-Width Modules -->
    <div class="flex flex-col gap-16">
      {
        modules.map((module: any, index: number) => {
          const isEven = index % 2 === 0;
          return (
            <div class={`bg-white dark:bg-[#171d26] rounded-[24px] border border-[#dadce0] dark:border-[#2a3443] p-6 sm:p-10 flex flex-col ${isEven ? 'lg:flex-row' : 'lg:flex-row-reverse'} gap-8 lg:gap-14 items-center scroll-mt-24 shadow-xs`} id={`module-${module.slug}`}>
              
              <!-- Content -->
              <div class="flex-1 flex flex-col items-start text-left">
                <div class="console-badge mb-3">
                  <span>Módulo Empresarial</span>
                </div>
                <h2 class="text-2xl sm:text-3xl font-semibold text-[#202124] dark:text-[#f1f3f4] mb-3 font-display">
                  {module.name}
                </h2>
                <p class="text-base text-[#1a73e8] dark:text-[#8ab4f8] font-medium leading-relaxed mb-4">
                  {module.shortDescription}
                </p>
                <p class="text-sm text-[#5f6368] dark:text-[#9aa0a6] leading-relaxed mb-6 line-clamp-3">
                  {module.description}
                </p>
                
                <a
                  href={`/${lang}/modules/${module.slug}`}
                  class="btn-primary"
                >
                  <span>Ver detalles del módulo</span>
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M5 12h14" />
                    <path d="m12 5 7 7-7 7" />
                  </svg>
                </a>
              </div>

              <!-- Image Container (Horizontal Rectangular Console Frame) -->
              <div class="flex-1 w-full">
                <a href={`/${lang}/modules/${module.slug}`} class="block relative group w-full bg-[#f8f9fa] dark:bg-[#12161f] rounded-2xl border border-[#dadce0]/80 dark:border-[#2a3443] p-3 overflow-hidden">
                  <img
                    src={module.image}
                    alt={module.name}
                    class="w-full h-auto object-contain rounded-xl group-hover:scale-[1.02] transition-transform duration-300 ease-out"
                  />
                </a>
              </div>
              
            </div>
          );
        })
      }
    </div>
  </div>
</section>