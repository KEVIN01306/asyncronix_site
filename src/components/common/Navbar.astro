---
import { ui } from "../../i18n/ui.i18n";
import { getLangFromUrl, useTranslations } from "../../i18n/utils.i18n";
import { LANGUAGES } from "../../i18n/config.i18n";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const currentPath = Astro.url.pathname;

// Function to generate path for a different language
const getSwitchLangPath = (newLang: string) => {
  const pathParts = currentPath.split("/");
  pathParts[1] = newLang; // Assuming format is /[lang]/...
  return pathParts.join("/") || `/${newLang}/`;
};

const navLinks = [
  { href: `/${lang}/`, label: t.nav.home },
  { href: `/${lang}/modules`, label: t.nav.modules },
  { href: `/${lang}/pricing`, label: t.nav.pricing },
  { href: `/${lang}/about`, label: t.nav.about },
  { href: `/${lang}/terms`, label: t.nav.terms },
  { href: `/${lang}/privacy`, label: t.nav.privacy },
];
---

<nav
  class="sticky top-0 z-50 w-full px-6 py-4 bg-white/70 backdrop-blur-xl border-b border-gray-100/50 shadow-sm transition-all duration-300"
  id="main-nav"
>
  <div class="max-w-7xl mx-auto flex justify-between items-center">
    <a
      href={`/${lang}/`}
      class="flex items-center gap-3 transition hover:opacity-80 group"
    >
      <img
        src="/logo.webp"
        class="w-8 h-8 object-contain transition-transform group-hover:scale-110"
        alt="Asyncronix Logo"
      />
      <span class="font-bold text-xl tracking-tight text-slate-800"
        >Asyncronix</span
      >
    </a>

    <!-- Desktop Navigation -->
    <div class="hidden lg:flex items-center gap-8">
      <ul class="flex items-center gap-6 text-sm font-medium text-slate-600">
        {
          navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="hover:text-[var(--color-primary)] transition-colors relative after:absolute after:-bottom-1 after:left-0 after:w-0 after:h-0.5 after:bg-gradient-to-r after:from-[var(--color-secondary)] after:to-[var(--color-primary)] hover:after:w-full after:transition-all after:duration-300"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>

      <div class="w-px h-6 bg-slate-200"></div>

      <!-- Language Selector -->
      <div class="relative group">
        <button
          class="flex items-center gap-1 px-3 py-1.5 text-sm font-medium text-slate-700 hover:text-[var(--color-primary)] transition-colors uppercase"
        >
          {lang}
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="opacity-70 group-hover:rotate-180 transition-transform"
            ><path d="m6 9 6 6 6-6"></path></svg
          >
        </button>
        <div
          class="absolute right-0 top-full mt-2 w-24 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 translate-y-2 group-hover:translate-y-0"
        >
          <div
            class="bg-white rounded-xl shadow-xl border border-slate-100 py-2 flex flex-col"
          >
            {
              Object.keys(LANGUAGES).map((l) => (
                <a
                  href={getSwitchLangPath(l)}
                  class={`px-4 py-2 text-sm text-center uppercase font-medium hover:bg-slate-50 transition-colors ${lang === l ? "text-[var(--color-primary)] bg-slate-50" : "text-slate-600"}`}
                >
                  {l}
                </a>
              ))
            }
          </div>
        </div>
      </div>

      <a
        href="https://app.asyncronix.com/"
        class="btn-primary py-2 px-5 text-sm shadow-md hover:shadow-lg"
      >
        {t.nav.login}
      </a>
    </div>

    <!-- Mobile Menu Button -->
    <button
      id="mobile-menu-btn"
      class="lg:hidden p-2 text-slate-600 hover:text-slate-900 transition-colors focus:outline-none"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="menu-icon"
        ><line x1="4" x2="20" y1="12" y2="12"></line><line
          x1="4"
          x2="20"
          y1="6"
          y2="6"></line><line x1="4" x2="20" y1="18" y2="18"></line></svg
      >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="close-icon hidden"
        ><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg
      >
    </button>
  </div>
</nav>

<!-- Mobile Drawer -->
<div
  id="mobile-drawer"
  class="fixed inset-0 top-[65px] bg-white/95 backdrop-blur-xl z-[100] lg:hidden flex-col translate-x-full transition-transform duration-300 border-t border-slate-100 h-[calc(100vh-65px)] flex"
>
  <div class="p-6 flex flex-col gap-6 flex-1 overflow-y-auto">
    <ul class="flex flex-col gap-4 text-lg font-medium text-slate-800">
      {
        navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class="block hover:text-[var(--color-primary)] transition-colors py-2 border-b border-slate-100 mobile-link"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="mt-4">
      <p
        class="text-sm text-slate-500 mb-3 uppercase tracking-wider font-semibold"
      >
        Idioma
      </p>
      <div class="flex flex-wrap gap-3">
        {
          Object.keys(LANGUAGES).map((l) => (
            <a
              href={getSwitchLangPath(l)}
              class={`px-4 py-2 rounded-lg text-sm uppercase font-medium border transition-colors ${lang === l ? "border-[var(--color-primary)] text-[var(--color-primary)] bg-[var(--color-primary)]/5" : "border-slate-200 text-slate-600 hover:bg-slate-50"}`}
            >
              {l}
            </a>
          ))
        }
      </div>
    </div>

    <div class="mt-auto pt-6 border-t border-slate-100 pb-8">
      <a
        href="https://app.asyncronix.com/"
        class="btn-primary w-full shadow-md text-center py-3 text-lg"
      >
        {t.nav.login}
      </a>
    </div>
  </div>
</div>

<script>
  // Mobile drawer toggle logic
  document.addEventListener("astro:page-load", () => {
    const btn = document.getElementById("mobile-menu-btn");
    const drawer = document.getElementById("mobile-drawer");
    const menuIcon = btn?.querySelector(".menu-icon");
    const closeIcon = btn?.querySelector(".close-icon");
    const mobileLinks = document.querySelectorAll(".mobile-link");

    let isOpen = false;

    const toggleDrawer = () => {
      isOpen = !isOpen;
      if (isOpen) {
        drawer?.classList.remove("translate-x-full");
        menuIcon?.classList.add("hidden");
        closeIcon?.classList.remove("hidden");
        document.body.style.overflow = "hidden"; // Prevent background scrolling
      } else {
        drawer?.classList.add("translate-x-full");
        menuIcon?.classList.remove("hidden");
        closeIcon?.classList.add("hidden");
        document.body.style.overflow = "";
      }
    };

    btn?.addEventListener("click", toggleDrawer);

    // Close drawer when clicking a link
    mobileLinks.forEach((link) => {
      link.addEventListener("click", () => {
        if (isOpen) toggleDrawer();
      });
    });
  });
</script>
