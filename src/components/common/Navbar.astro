---
import { ui } from "../../i18n/ui.i18n";
import { getLangFromUrl, useTranslations } from "../../i18n/utils.i18n";
import { LANGUAGES } from "../../i18n/config.i18n";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const currentPath = Astro.url.pathname;

// Function to generate path for a different language
const getSwitchLangPath = (newLang: string) => {
  const pathParts = currentPath.split("/");
  pathParts[1] = newLang; // Assuming format is /[lang]/...
  return pathParts.join("/") || `/${newLang}/`;
};

const navLinks = [
  { href: `/${lang}/`, label: t.nav.home },
  { href: `/${lang}/modules`, label: t.nav.modules },
  { href: `/${lang}/pricing`, label: t.nav.pricing },
  { href: `/${lang}/about`, label: t.nav.about },
  { href: `/${lang}/terms`, label: t.nav.terms },
  { href: `/${lang}/privacy`, label: t.nav.privacy },
];
---

<nav
  class="sticky top-0 z-50 w-full px-6 py-4 bg-white/70 dark:bg-slate-900/80 backdrop-blur-xl border-b border-gray-100/50 dark:border-slate-800/50 shadow-sm dark:shadow-slate-900/50 transition-colors duration-300"
  id="main-nav"
>
  <div class="max-w-7xl mx-auto flex justify-between items-center">
    <a
      href={`/${lang}/`}
      class="flex items-center gap-3 transition hover:opacity-80 group"
    >
      <img
        src="/logo.webp"
        class="w-8 h-8 object-contain transition-transform group-hover:scale-110"
        alt="Asyncronix Logo"
      />
      <span class="font-bold text-xl tracking-tight text-slate-800 dark:text-white"
        >Asyncronix</span
      >
    </a>

    <!-- Desktop Navigation -->
    <div class="hidden lg:flex items-center gap-8">
      <ul class="flex items-center gap-6 text-sm font-medium text-slate-600 dark:text-slate-300">
        {
          navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="hover:text-[var(--color-primary)] dark:hover:text-[var(--color-primary)] transition-colors relative after:absolute after:-bottom-1 after:left-0 after:w-0 after:h-0.5 after:bg-gradient-to-r after:from-[var(--color-secondary)] after:to-[var(--color-primary)] hover:after:w-full after:transition-all after:duration-300"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>

      <div class="w-px h-6 bg-slate-200 dark:bg-slate-700"></div>

      <!-- Theme Toggle -->
      <button
        id="theme-toggle-desktop"
        class="p-2 text-slate-600 dark:text-slate-300 hover:text-[var(--color-primary)] dark:hover:text-[var(--color-primary)] transition-colors focus:outline-none rounded-full hover:bg-slate-100 dark:hover:bg-slate-800"
        aria-label="Toggle Dark Mode"
      >
        <svg id="theme-toggle-light-icon-desktop" class="w-5 h-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
        <svg id="theme-toggle-dark-icon-desktop" class="w-5 h-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
      </button>

      <!-- Language Selector -->
      <div class="relative group">
        <button
          class="flex items-center gap-1 px-3 py-1.5 text-sm font-medium text-slate-700 dark:text-slate-300 hover:text-[var(--color-primary)] dark:hover:text-[var(--color-primary)] transition-colors uppercase"
        >
          {lang}
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="opacity-70 group-hover:rotate-180 transition-transform"
            ><path d="m6 9 6 6 6-6"></path></svg
          >
        </button>
        <div
          class="absolute right-0 top-full mt-2 w-24 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 translate-y-2 group-hover:translate-y-0"
        >
          <div
            class="bg-white dark:bg-slate-800 rounded-xl shadow-xl border border-slate-100 dark:border-slate-700 py-2 flex flex-col"
          >
            {
              Object.keys(LANGUAGES).map((l) => (
                <a
                  href={getSwitchLangPath(l)}
                  class={`px-4 py-2 text-sm text-center uppercase font-medium hover:bg-slate-50 dark:hover:bg-slate-700 transition-colors ${lang === l ? "text-[var(--color-primary)] bg-slate-50 dark:bg-slate-700" : "text-slate-600 dark:text-slate-300"}`}
                >
                  {l}
                </a>
              ))
            }
          </div>
        </div>
      </div>

      <a
        href="https://app.asyncronix.com/"
        class="btn-primary py-2 px-5 text-sm shadow-md hover:shadow-lg"
      >
        {t.nav.login}
      </a>
    </div>

    <!-- Mobile Controls -->
    <div class="flex items-center gap-2 lg:hidden">
      <!-- Theme Toggle Mobile -->
      <button
        id="theme-toggle-mobile"
        class="p-2 text-slate-600 dark:text-slate-300 hover:text-[var(--color-primary)] transition-colors focus:outline-none rounded-full hover:bg-slate-100 dark:hover:bg-slate-800"
        aria-label="Toggle Dark Mode"
      >
        <svg id="theme-toggle-light-icon-mobile" class="w-5 h-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
        <svg id="theme-toggle-dark-icon-mobile" class="w-5 h-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
      </button>

      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-btn"
        class="p-2 text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white transition-colors focus:outline-none"
      >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="menu-icon"
        ><line x1="4" x2="20" y1="12" y2="12"></line><line
          x1="4"
          x2="20"
          y1="6"
          y2="6"></line><line x1="4" x2="20" y1="18" y2="18"></line></svg
      >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="close-icon hidden"
        ><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg
      >
      </button>
    </div>
  </div>
</nav>

<!-- Mobile Drawer -->
<div
  id="mobile-drawer"
  class="fixed inset-0 top-[65px] bg-white/95 dark:bg-slate-900/95 backdrop-blur-xl z-[100] lg:hidden flex-col translate-x-full transition-transform duration-300 border-t border-slate-100 dark:border-slate-800 h-[calc(100vh-65px)] flex"
>
  <div class="p-6 flex flex-col gap-6 flex-1 overflow-y-auto">
    <ul class="flex flex-col gap-4 text-lg font-medium text-slate-800 dark:text-slate-200">
      {
        navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class="block hover:text-[var(--color-primary)] dark:hover:text-[var(--color-primary)] transition-colors py-2 border-b border-slate-100 dark:border-slate-800 mobile-link"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="mt-4">
      <p
        class="text-sm text-slate-500 dark:text-slate-400 mb-3 uppercase tracking-wider font-semibold"
      >
        Idioma
      </p>
      <div class="flex flex-wrap gap-3">
        {
          Object.keys(LANGUAGES).map((l) => (
            <a
              href={getSwitchLangPath(l)}
              class={`px-4 py-2 rounded-lg text-sm uppercase font-medium border transition-colors ${lang === l ? "border-[var(--color-primary)] text-[var(--color-primary)] bg-[var(--color-primary)]/5" : "border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-400 hover:bg-slate-50 dark:hover:bg-slate-800"}`}
            >
              {l}
            </a>
          ))
        }
      </div>
    </div>

    <div class="mt-auto pt-6 border-t border-slate-100 dark:border-slate-800 pb-8">
      <a
        href="https://app.asyncronix.com/"
        class="btn-primary w-full shadow-md text-center py-3 text-lg"
      >
        {t.nav.login}
      </a>
    </div>
  </div>
</div>

<script>
  // Mobile drawer toggle logic
  document.addEventListener("astro:page-load", () => {
    const btn = document.getElementById("mobile-menu-btn");
    const drawer = document.getElementById("mobile-drawer");
    const menuIcon = btn?.querySelector(".menu-icon");
    const closeIcon = btn?.querySelector(".close-icon");
    const mobileLinks = document.querySelectorAll(".mobile-link");

    let isOpen = false;

    // Theme Toggle Logic
    const themeToggleDesktop = document.getElementById("theme-toggle-desktop");
    const themeToggleMobile = document.getElementById("theme-toggle-mobile");
    const lightIcons = document.querySelectorAll("#theme-toggle-light-icon-desktop, #theme-toggle-light-icon-mobile");
    const darkIcons = document.querySelectorAll("#theme-toggle-dark-icon-desktop, #theme-toggle-dark-icon-mobile");

    const updateThemeIcons = (isDark: boolean) => {
      if (isDark) {
        lightIcons.forEach(icon => icon.classList.remove("hidden"));
        darkIcons.forEach(icon => icon.classList.add("hidden"));
      } else {
        lightIcons.forEach(icon => icon.classList.add("hidden"));
        darkIcons.forEach(icon => icon.classList.remove("hidden"));
      }
    };

    const toggleTheme = () => {
      const isDark = document.documentElement.classList.toggle("dark");
      localStorage.setItem("theme", isDark ? "dark" : "light");
      updateThemeIcons(isDark);
    };

    // Initial check
    if (document.documentElement.classList.contains("dark")) {
      updateThemeIcons(true);
    } else {
      updateThemeIcons(false);
    }

    themeToggleDesktop?.addEventListener("click", toggleTheme);
    themeToggleMobile?.addEventListener("click", toggleTheme);

    const toggleDrawer = () => {
      isOpen = !isOpen;
      if (isOpen) {
        drawer?.classList.remove("translate-x-full");
        menuIcon?.classList.add("hidden");
        closeIcon?.classList.remove("hidden");
        document.body.style.overflow = "hidden"; // Prevent background scrolling
      } else {
        drawer?.classList.add("translate-x-full");
        menuIcon?.classList.remove("hidden");
        closeIcon?.classList.add("hidden");
        document.body.style.overflow = "";
      }
    };

    btn?.addEventListener("click", toggleDrawer);

    // Close drawer when clicking a link
    mobileLinks.forEach((link) => {
      link.addEventListener("click", () => {
        if (isOpen) toggleDrawer();
      });
    });
  });
</script>
