---

export interface Review {
    name: string;
    comment: string;
    rating: number;
    date: string;
}

interface ReviewsProps {
    title: string;
    reviews: Review[] | null;
}

const title = Astro.props.title as ReviewsProps['title'];
const reviews = Astro.props.reviews as ReviewsProps['reviews'];
---

<div class="w-full max-w-6xl mx-auto py-12 px-4 sm:px-6 lg:px-8 font-sans">
    <header class="text-center mb-10 flex flex-col items-center justify-center">
        <div class="console-badge mb-3">
            <span>Calificaciones Verificadas</span>
        </div>
        <h2 class="font-semibold text-3xl md:text-4xl text-[#202124] dark:text-[#f1f3f4] mb-4 font-display">{title}</h2>
        
        <div class="flex flex-col items-center gap-1.5">
            <div class="flex items-center gap-2">
                <span class="font-bold text-xl text-[#202124] dark:text-[#f1f3f4]">4.89</span>
                <div class="flex text-[#f9ab00] gap-0.5">
                    {Array.from({ length: 5 }).map(() => (
                        <svg class="w-5 h-5 fill-current" viewBox="0 0 20 20">
                            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                        </svg>
                    ))}
                </div>
                <span class="text-[#5f6368] dark:text-[#9aa0a6] text-sm ml-1 font-medium">(89 valoraciones)</span>
            </div>
        </div>
    </header>

    <div class="relative group review-carousel-container w-full">
        
        <button class="prev-btn absolute left-2 lg:-left-5 top-1/2 -translate-y-1/2 z-10 bg-white dark:bg-[#1e2634] border border-[#dadce0] dark:border-[#2a3443] rounded-full p-2 text-[#5f6368] dark:text-[#9aa0a6] hover:text-[#1a73e8] dark:hover:text-[#8ab4f8] hover:bg-[#f8f9fa] dark:hover:bg-[#171d26] shadow-sm transition-all focus:outline-none" aria-label="Anterior">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
            </svg>
        </button>

        <div class="review-track w-full flex overflow-x-hidden snap-x snap-mandatory gap-5 pb-6 pt-2 px-1 no-scrollbar scroll-smooth">
            {reviews?.map((review) => (
                <div class="snap-center shrink-0 w-[320px] md:w-[360px] bg-white dark:bg-[#171d26] border border-[#dadce0] dark:border-[#2a3443] rounded-[20px] p-6 shadow-xs flex flex-col justify-between transition-colors duration-200">
                    <div>
                        <!-- Info del usuario -->
                        <div class="flex items-center gap-3 mb-5">
                            <div class="w-10 h-10 rounded-full bg-[#e8f0fe] dark:bg-[#1e2634] text-[#1a73e8] dark:text-[#8ab4f8] border border-[#dadce0]/60 dark:border-[#2a3443] flex items-center justify-center font-bold text-sm">
                                {review.name.charAt(0)}
                            </div>
                            <div class="flex flex-col">
                                <h3 class="font-semibold text-[#202124] dark:text-[#f1f3f4] text-sm leading-tight">{review.name}</h3>
                                <p class="text-xs text-[#5f6368] dark:text-[#9aa0a6] mt-0.5">{review.date}</p>
                            </div>
                        </div>

                        <div class="flex items-center justify-between gap-1 mb-3 pb-3 border-b border-[#dadce0]/50 dark:border-[#2a3443]">
                            <div class="flex text-[#f9ab00] gap-0.5">
                                {Array.from({ length: 5 }).map((_, i) => (
                                    <svg class={`w-3.5 h-3.5 ${i < review.rating ? 'fill-current' : 'text-[#dadce0] dark:text-[#3c4043] fill-current'}`} viewBox="0 0 20 20">
                                        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                                    </svg>
                                ))}
                            </div>
                            <div class="inline-flex items-center gap-1 text-[11px] font-medium text-[#188038] dark:text-[#81c995]">
                                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
                                </svg>
                                <span>Verificado</span>
                            </div>
                        </div>

                        <p class="text-sm text-[#3c4043] dark:text-[#c4c7c5] leading-relaxed font-normal">
                            "{review.comment}"
                        </p>
                    </div>

                </div>
            ))}
        </div>

        <button class="next-btn absolute right-2 lg:-right-5 top-1/2 -translate-y-1/2 z-10 bg-white dark:bg-[#1e2634] border border-[#dadce0] dark:border-[#2a3443] rounded-full p-2 text-[#5f6368] dark:text-[#9aa0a6] hover:text-[#1a73e8] dark:hover:text-[#8ab4f8] hover:bg-[#f8f9fa] dark:hover:bg-[#171d26] shadow-sm transition-all focus:outline-none" aria-label="Siguiente">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
        </button>

    </div>
</div>

<style>
    .no-scrollbar::-webkit-scrollbar {
        display: none;
    }
    .no-scrollbar {
        -ms-overflow-style: none;
        scrollbar-width: none;
    }
</style>

<script>
    // Lógica para inicializar múltiples carruseles si fuera necesario y manejar clics
    function setupCarousels() {
        const carousels = document.querySelectorAll('.review-carousel-container');
        
        carousels.forEach(container => {
            const track = container.querySelector('.review-track');
            const prevBtn = container.querySelector('.prev-btn');
            const nextBtn = container.querySelector('.next-btn');

            if (!track || !prevBtn || !nextBtn) return;

            // Cantidad a scrollear: Ancho de la tarjeta + gap aprox
            const scrollAmount = 380; 

            prevBtn.addEventListener('click', () => {
                track.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
            });

            nextBtn.addEventListener('click', () => {
                track.scrollBy({ left: scrollAmount, behavior: 'smooth' });
            });
        });
    }

    setupCarousels();
    
    // Soporte para Astro View Transitions (si las usas en tu proyecto)
    document.addEventListener('astro:page-load', setupCarousels);
</script>