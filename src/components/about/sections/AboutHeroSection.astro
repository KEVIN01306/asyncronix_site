---
const { data } = Astro.props;
---

<section class="relative w-full h-[360px] sm:h-[420px] overflow-hidden bg-[#f8f9fa] dark:bg-[#0f1318] border-b border-[#dadce0] dark:border-[#2a3443]">
  <img
    src="/images/group_job.png"
    alt={data.title}
    class="w-full h-full object-cover opacity-90 dark:opacity-80"
  />
  <div class="absolute inset-0 bg-gradient-to-t from-[#f8f9fa] dark:from-[#0f1318] via-transparent to-transparent"></div>
</section>

