---
const { team, mission } = Astro.props;
---

<section class="py-16 bg-[#f8f9fa] dark:bg-[#0f1318] relative transition-colors duration-200">
  <div
    class="max-w-7xl mx-auto px-4 sm:px-6 grid lg:grid-cols-2 gap-12 lg:gap-16 items-center"
  >
    <!-- Columna Izquierda: Contenido -->
    <div class="flex flex-col gap-8">
      <div>
        <!-- Badge de Ubicación -->
        <div
          class="console-badge mb-4"
        >
          <span class="w-2 h-2 rounded-full bg-[#188038] dark:bg-[#81c995]"></span>
          <span>{team.location}</span>
        </div>

        <h1
          class="text-3xl sm:text-4xl font-semibold text-[#202124] dark:text-[#f1f3f4] mb-4 tracking-tight font-display"
        >
          {team.title}
        </h1>
        <p class="text-base sm:text-lg text-[#5f6368] dark:text-[#9aa0a6] leading-relaxed font-normal">
          {team.description}
        </p>
      </div>

      <!-- Tarjeta de Misión -->
      <div
        class="p-6 sm:p-8 rounded-[20px] bg-white dark:bg-[#171d26] border border-[#dadce0] dark:border-[#2a3443] shadow-xs relative overflow-hidden"
      >
        <!-- Acento lateral Google Blue -->
        <div
          class="absolute top-0 left-0 w-1 h-full bg-[#1a73e8]"
        >
        </div>

        <div class="relative z-10 pl-2">
          <div class="flex items-center gap-2 mb-2 text-[#1a73e8] dark:text-[#8ab4f8]">
            <svg
              class="w-4 h-4"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M13 10V3L4 14h7v7l9-11h-7z"></path>
            </svg>
            <h2 class="text-xs font-semibold uppercase tracking-wider">
              {mission.title}
            </h2>
          </div>
          <p class="text-base sm:text-lg text-[#202124] dark:text-[#f1f3f4] leading-relaxed font-medium">
            "{mission.description}"
          </p>
        </div>
      </div>
    </div>

    <!-- Columna Derecha: Imagen en marco de consola -->
    <div
      class="relative w-full aspect-square md:aspect-[4/5] max-h-[520px] mx-auto max-w-md lg:max-w-none"
    >
      <div
        class="w-full h-full relative z-10 rounded-[24px] overflow-hidden border border-[#dadce0] dark:border-[#2a3443] bg-white dark:bg-[#171d26] shadow-sm p-3"
      >
        <img
          src="/images/world_asyncronix.webp"
          alt="Equipo Asyncronix"
          class="w-full h-full object-cover rounded-[18px]"
        />
      </div>
    </div>
  </div>
</section>

