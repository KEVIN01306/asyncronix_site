---
const { team, mission } = Astro.props;
---

<section class="py-24 bg-white relative bg-pattern">
  <div class="max-w-7xl mx-auto px-6 grid md:grid-cols-2 gap-16 items-center">
    <div class="flex flex-col gap-10">
      <div>
        <h2 class="text-3xl font-bold text-slate-900 mb-4">{team.title}</h2>
        <p class="text-lg text-slate-600 leading-relaxed mb-4">
          {team.description}
        </p>
        <div
          class="inline-flex items-center gap-2 px-4 py-2 bg-slate-50 text-slate-700 font-medium rounded-full border border-slate-200"
        >
          <span>🌎</span>
          {team.location}
        </div>
      </div>

      <div
        class="p-8 rounded-[2rem] bg-gradient-to-br from-slate-50 to-slate-100 border border-slate-200 shadow-sm relative overflow-hidden"
      >
        <div class="absolute top-0 right-0 p-4 opacity-10">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="100"
            height="100"
            viewBox="0 0 24 24"
            fill="currentColor"
            ><path d="M12 2L1 21h22M12 6l7.5 13h-15z"></path></svg
          >
        </div>
        <h2 class="text-2xl font-bold text-slate-900 mb-4">{mission.title}</h2>
        <p
          class="text-lg text-slate-700 leading-relaxed font-medium relative z-10"
        >
          {mission.description}
        </p>
      </div>
    </div>

    <div
      class="relative w-full aspect-square md:aspect-auto md:h-full md:min-h-[400px]"
    >
      <div
        class="absolute inset-0 bg-gradient-to-tr from-[var(--color-primary)] to-[var(--color-secondary)] opacity-20 rounded-[3rem] -rotate-3 scale-105"
      >
      </div>
      <img
        src="/images/world_asyncronix.webp"
        alt="Equipo Asyncronix"
        class="w-full h-full object-cover rounded-[3rem] shadow-xl relative z-10 border-4 border-white hover:scale-[1.1] transition-all duration-700"
      />
    </div>
  </div>
</section>
