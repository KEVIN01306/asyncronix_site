---
const { data } = Astro.props;
---

<section
  class="py-24 bg-slate-50 dark:bg-slate-900 relative bg-pattern transition-colors duration-300"
>
  <div class="max-w-7xl mx-auto px-6">
    <!-- Encabezado -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2
        class="text-4xl md:text-5xl font-extrabold text-slate-900 dark:text-white tracking-tight mb-4"
      >
        {data.hero.title}
      </h2>
      <p class="text-xl text-slate-500 dark:text-slate-400">
        {data.hero.subtitle}
      </p>
    </div>

    <!-- Pricing State JSON for Client script -->
    <script
      id="pricing-data"
      type="application/json"
      set:html={JSON.stringify(data)}
    />

    <div class="grid lg:grid-cols-3 gap-8 items-start">
      <!-- Lado Izquierdo: Selección de Planes y Addons -->
      <div class="lg:col-span-2 flex flex-col gap-8">
        <!-- Tarjeta: Planes -->
        <div
          class="bg-white dark:bg-slate-800 rounded-[2rem] border border-slate-200 dark:border-slate-700 shadow-sm p-8 md:p-10 transition-colors duration-300"
        >
          <h3
            class="text-xl font-bold text-slate-900 dark:text-white mb-8 flex items-center gap-2"
          >
            <span
              class="flex items-center justify-center w-6 h-6 rounded-full bg-slate-100 dark:bg-slate-700 text-slate-500 dark:text-slate-300 text-sm"
              >1</span
            >
            {data.calculator.selectPlan}
          </h3>

          <div class="grid md:grid-cols-2 gap-6">
            <!-- Base Plan -->
            <label class="relative cursor-pointer group">
              <input
                type="radio"
                name="plan"
                value={data.plans.base.id}
                class="peer sr-only"
                checked
              />
              <div
                class="h-full rounded-2xl border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 p-6 hover:border-slate-300 dark:hover:border-slate-600 peer-checked:border-slate-900 dark:peer-checked:border-white peer-checked:shadow-md transition-all flex flex-col"
              >
                <div class="flex justify-between items-center mb-2">
                  <h4 class="text-lg font-bold text-slate-900 dark:text-white">
                    {data.plans.base.name}
                  </h4>
                  <!-- Radio Button Custom -->
                  <div
                    class="w-5 h-5 rounded-full border-2 border-slate-300 dark:border-slate-600 peer-checked:border-[6px] peer-checked:border-[var(--color-primary)] transition-all"
                  >
                  </div>
                </div>
                <div
                  class="text-4xl font-extrabold text-slate-900 dark:text-white mb-6"
                >
                  ${data.plans.base.price}
                  <span
                    class="text-sm font-medium text-slate-500 dark:text-slate-400 font-normal"
                    >/ mes</span
                  >
                </div>

                <div class="h-px w-full bg-slate-100 dark:bg-slate-800 mb-6">
                </div>

                <ul class="flex flex-col gap-4 mt-auto">
                  {
                    data.plans.base.features.map((feature: string) => (
                      <li class="flex items-start gap-3 text-sm text-slate-600 dark:text-slate-400 font-medium">
                        <svg
                          class="w-5 h-5 text-slate-400 dark:text-slate-500 shrink-0"
                          fill="none"
                          viewBox="0 0 24 24"
                          stroke="currentColor"
                          stroke-width="2.5"
                        >
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M5 13l4 4L19 7"
                          />
                        </svg>
                        {feature}
                      </li>
                    ))
                  }
                </ul>
              </div>
            </label>

            <!-- Store Plan -->
            <label class="relative cursor-pointer group">
              <input
                type="radio"
                name="plan"
                value={data.plans.store.id}
                class="peer sr-only"
              />
              <div
                class="h-full rounded-2xl border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 p-6 hover:border-slate-300 dark:hover:border-slate-600 peer-checked:border-slate-900 dark:peer-checked:border-white peer-checked:shadow-md transition-all relative overflow-hidden flex flex-col"
              >
                <!-- Badge Profesional (Sin gradiente) -->
                <div
                  class="absolute top-0 right-0 bg-slate-900 dark:bg-slate-100 text-white dark:text-slate-900 text-[10px] font-bold tracking-wider uppercase px-3 py-1.5 rounded-bl-lg"
                >
                  Popular
                </div>

                <div class="flex justify-between items-center mb-2">
                  <h4 class="text-lg font-bold text-slate-900 dark:text-white">
                    {data.plans.store.name}
                  </h4>
                  <div
                    class="w-5 h-5 rounded-full border-2 border-slate-300 dark:border-slate-600 peer-checked:border-[6px] peer-checked:border-[var(--color-primary)] transition-all"
                  >
                  </div>
                </div>
                <div
                  class="text-4xl font-extrabold text-slate-900 dark:text-white mb-6"
                >
                  ${data.plans.store.price}
                  <span
                    class="text-sm font-medium text-slate-500 dark:text-slate-400 font-normal"
                    >/ mes</span
                  >
                </div>

                <div class="h-px w-full bg-slate-100 dark:bg-slate-800 mb-6">
                </div>

                <ul class="flex flex-col gap-4 mt-auto">
                  {
                    data.plans.store.features.map((feature: string) => (
                      <li class="flex items-start gap-3 text-sm text-slate-600 dark:text-slate-400 font-medium">
                        <svg
                          class="w-5 h-5 text-slate-900 dark:text-slate-300 shrink-0"
                          fill="none"
                          viewBox="0 0 24 24"
                          stroke="currentColor"
                          stroke-width="2.5"
                        >
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M5 13l4 4L19 7"
                          />
                        </svg>
                        {feature}
                      </li>
                    ))
                  }
                </ul>
              </div>
            </label>
          </div>
        </div>

        <!-- Tarjeta: Addons -->
        <div
          class="bg-white dark:bg-slate-800 rounded-[2rem] border border-slate-200 dark:border-slate-700 shadow-sm p-8 md:p-10 transition-colors duration-300"
        >
          <h3
            class="text-xl font-bold text-slate-900 dark:text-white mb-6 flex items-center gap-2"
          >
            <span
              class="flex items-center justify-center w-6 h-6 rounded-full bg-slate-100 dark:bg-slate-700 text-slate-500 dark:text-slate-300 text-sm"
              >2</span
            >
            {data.calculator.selectWhatsapp}
          </h3>

          <div class="flex flex-col gap-4">
            {
              data.addons.whatsapp.options.map((option: any, idx: number) => (
                <label class="relative cursor-pointer group flex items-center justify-between p-5 rounded-xl border-2 border-slate-100 dark:border-slate-700 hover:border-slate-200 dark:hover:border-slate-600 bg-white dark:bg-slate-900 transition-all has-[:checked]:border-slate-900 dark:has-[:checked]:border-white has-[:checked]:shadow-sm">
                  <div class="flex items-center gap-4">
                    <input
                      type="radio"
                      name="whatsapp"
                      value={option.id}
                      class="w-5 h-5 accent-slate-900 dark:accent-white"
                      checked={idx === 0}
                    />
                    <div>
                      <p class="font-bold text-slate-900 dark:text-white">
                        {option.name}
                      </p>
                      <p class="text-sm text-slate-500 dark:text-slate-400 mt-0.5">
                        {option.description}
                      </p>
                    </div>
                  </div>
                  <div class="font-bold text-slate-900 dark:text-white whitespace-nowrap bg-slate-50 dark:bg-slate-800 px-3 py-1 rounded-md text-sm border border-slate-100 dark:border-slate-700">
                    {option.isCustom ? "Varía" : `+$${option.price}`}
                  </div>
                </label>
              ))
            }
          </div>
        </div>
      </div>

      <!-- Lado Derecho: Resumen (Sidebar) -->
      <div class="lg:col-span-1 lg:sticky lg:top-32">
        <div
          class="bg-slate-900 dark:bg-slate-950 rounded-[2rem] shadow-xl p-8 md:p-10 text-white transition-colors duration-300 border border-transparent dark:border-slate-800"
        >
          <h3 class="text-lg font-bold mb-6 border-b border-slate-700 pb-4">
            Resumen de tu plan
          </h3>

          <div
            class="flex justify-between items-center mb-4 text-slate-300 text-sm"
          >
            <span id="summary-plan-name">{data.plans.base.name}</span>
            <span id="summary-plan-price" class="font-semibold text-white">
              ${data.plans.base.price}
            </span>
          </div>

          <div
            class="flex justify-between items-center mb-6 text-slate-300 text-sm pb-6 border-b border-slate-700"
          >
            <span id="summary-whatsapp-name">
              {data.addons.whatsapp.options[0].name}
            </span>
            <span id="summary-whatsapp-price" class="font-semibold text-white">
              +$0
            </span>
          </div>

          <div class="flex justify-between items-end mb-8">
            <span class="text-sm font-medium text-slate-300">
              {data.calculator.total}
            </span>
            <div class="text-right">
              <span
                id="summary-total"
                class="text-4xl font-extrabold text-white"
              >
                ${data.plans.base.price}
              </span>
              <div class="text-xs text-slate-400 font-medium mt-1">
                Facturado mensualmente
              </div>
            </div>
          </div>

          <!-- Botón primario de tu marca -->
          <button
            class="btn-primary w-full py-4 text-lg font-bold rounded-xl hover:-translate-y-1 transition-transform shadow-lg shadow-[var(--color-primary)]/20"
          >
            Contratar Ahora
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- El Script se mantiene idéntico, ya que la lógica no cambia -->
<script>
  function initPricingCalculator() {
    const dataEl = document.getElementById("pricing-data");
    if (!dataEl) return;

    const data = JSON.parse(dataEl.textContent || "{}");

    const planInputs = document.querySelectorAll('input[name="plan"]');
    const whatsappInputs = document.querySelectorAll('input[name="whatsapp"]');

    const summaryPlanName = document.getElementById("summary-plan-name");
    const summaryPlanPrice = document.getElementById("summary-plan-price");
    const summaryWhatsappName = document.getElementById(
      "summary-whatsapp-name",
    );
    const summaryWhatsappPrice = document.getElementById(
      "summary-whatsapp-price",
    );
    const summaryTotal = document.getElementById("summary-total");

    let currentPlan = data.plans.base;
    let currentWhatsapp = data.addons.whatsapp.options[0];

    function updateSummary() {
      if (summaryPlanName) summaryPlanName.textContent = currentPlan.name;
      if (summaryPlanPrice)
        summaryPlanPrice.textContent = `$${currentPlan.price}`;

      if (summaryWhatsappName)
        summaryWhatsappName.textContent = currentWhatsapp.name;
      if (summaryWhatsappPrice)
        summaryWhatsappPrice.textContent = currentWhatsapp.isCustom
          ? "Varía"
          : `+$${currentWhatsapp.price}`;

      const total =
        currentPlan.price +
        (currentWhatsapp.isCustom ? 0 : currentWhatsapp.price);
      if (summaryTotal) summaryTotal.textContent = `$${total}`;
    }

    planInputs.forEach((input) => {
      input.addEventListener("change", (e) => {
        const target = e.target as HTMLInputElement;
        if (target.value === "base") currentPlan = data.plans.base;
        if (target.value === "store") currentPlan = data.plans.store;
        updateSummary();
      });
    });

    whatsappInputs.forEach((input) => {
      input.addEventListener("change", (e) => {
        const target = e.target as HTMLInputElement;
        const opt = data.addons.whatsapp.options.find(
          (o: any) => o.id === target.value,
        );
        if (opt) {
          currentWhatsapp = opt;
          updateSummary();
        }
      });
    });
  }

  // Ejecutar inicialización al cargar la página y después de transiciones de vista (View Transitions)
  document.addEventListener("astro:page-load", initPricingCalculator);
</script>
