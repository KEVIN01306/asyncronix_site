---
const { data } = Astro.props;
---

<section class="py-14 bg-[#f8f9fa] dark:bg-[#0f1318] relative transition-colors duration-200">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <!-- Header: Console Plan Configurator -->
    <div class="mb-10">
      <div class="console-badge mb-3">
        <span>Configuración de Planes & Facturación</span>
      </div>
      <h1 class="text-3xl md:text-4xl font-semibold text-[#202124] dark:text-[#f1f3f4] tracking-tight font-display">
        {data.hero.title || "Tu suscripción"}
      </h1>
      {data.hero.subtitle && (
        <p class="text-base text-[#5f6368] dark:text-[#9aa0a6] mt-2 max-w-2xl">{data.hero.subtitle}</p>
      )}
    </div>

    <!-- Pricing State JSON for Client script -->
    <script id="pricing-data" type="application/json" set:html={JSON.stringify(data)} />

    <div class="grid lg:grid-cols-3 gap-8 items-start">
      <!-- Lado Izquierdo: Selección de Planes y Addons -->
      <div class="lg:col-span-2 flex flex-col gap-6">
        
        <!-- Tarjeta 1: Plan Selection -->
        <div class="bg-white dark:bg-[#171d26] rounded-[24px] border border-[#dadce0] dark:border-[#2a3443] p-6 sm:p-8 shadow-xs transition-colors duration-200">
          <div class="flex items-center gap-3.5 mb-6">
            <div class="w-10 h-10 bg-[#e8f0fe] dark:bg-[#1e2634] text-[#1a73e8] dark:text-[#8ab4f8] rounded-xl flex items-center justify-center border border-[#dadce0]/60 dark:border-[#2a3443]">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z" />
                <polyline points="3.27 6.96 12 12.01 20.73 6.96" />
                <line x1="12" y1="22.08" x2="12" y2="12" />
              </svg>
            </div>
            <div>
              <h2 class="text-lg font-semibold text-[#202124] dark:text-[#f1f3f4]">
                {data.calculator.selectPlan}
              </h2>
              <p class="text-xs text-[#5f6368] dark:text-[#9aa0a6]">Selecciona el nivel de servicio para tu empresa</p>
            </div>
          </div>

          <div class="flex flex-col gap-3.5">
            <!-- Base Plan -->
            <label class="relative cursor-pointer group block">
              <input type="radio" name="plan" value={data.plans.base.id} class="peer sr-only" checked />
              <div class="rounded-2xl border border-[#dadce0] dark:border-[#2a3443] bg-white dark:bg-[#171d26] p-5 hover:border-[#1a73e8]/60 dark:hover:border-[#8ab4f8]/60 peer-checked:border-[#1a73e8] dark:peer-checked:border-[#8ab4f8] peer-checked:bg-[#e8f0fe]/30 dark:peer-checked:bg-[#1a73e8]/10 transition-all flex flex-col md:flex-row md:items-center justify-between gap-4">
                
                <div class="flex items-start gap-3.5">
                  <div class="w-5 h-5 mt-0.5 rounded-full border-2 border-[#dadce0] dark:border-[#5f6368] peer-checked:border-[#1a73e8] dark:peer-checked:border-[#8ab4f8] peer-checked:border-[5px] bg-white dark:bg-[#171d26] transition-all shrink-0"></div>
                  <div>
                    <h3 class="text-base font-semibold text-[#202124] dark:text-[#f1f3f4]">{data.plans.base.name}</h3>
                    <ul class="mt-2.5 flex flex-col gap-1.5">
                      {data.plans.base.features.slice(0, 3).map((feature: string) => (
                        <li class="text-xs sm:text-sm text-[#5f6368] dark:text-[#9aa0a6] flex items-center gap-2">
                          <svg class="w-4 h-4 text-[#188038] dark:text-[#81c995] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                          {feature}
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>

                <div class="text-left md:text-right ml-8 md:ml-0 md:pl-4 border-t md:border-t-0 pt-3 md:pt-0 border-[#dadce0]/60 dark:border-[#2a3443]">
                  <div class="text-2xl font-bold text-[#202124] dark:text-[#f1f3f4] whitespace-nowrap font-display">
                    ${data.plans.base.price} <span class="text-xs font-normal text-[#5f6368] dark:text-[#9aa0a6]">US$/mes</span>
                  </div>
                  <div class="text-[11px] text-[#5f6368] dark:text-[#9aa0a6] mt-0.5">Facturación recurrente mensual</div>
                </div>
              </div>
            </label>

            <!-- Store Plan -->
            <label class="relative cursor-pointer group block">
              <input type="radio" name="plan" value={data.plans.store.id} class="peer sr-only" />
              <div class="rounded-2xl border border-[#dadce0] dark:border-[#2a3443] bg-white dark:bg-[#171d26] p-5 hover:border-[#1a73e8]/60 dark:hover:border-[#8ab4f8]/60 peer-checked:border-[#1a73e8] dark:peer-checked:border-[#8ab4f8] peer-checked:bg-[#e8f0fe]/30 dark:peer-checked:bg-[#1a73e8]/10 transition-all flex flex-col md:flex-row md:items-center justify-between gap-4">
                
                <div class="flex items-start gap-3.5">
                  <div class="w-5 h-5 mt-0.5 rounded-full border-2 border-[#dadce0] dark:border-[#5f6368] peer-checked:border-[#1a73e8] dark:peer-checked:border-[#8ab4f8] peer-checked:border-[5px] bg-white dark:bg-[#171d26] transition-all shrink-0"></div>
                  <div>
                    <div class="flex items-center gap-2">
                      <h3 class="text-base font-semibold text-[#202124] dark:text-[#f1f3f4]">{data.plans.store.name}</h3>
                      <span class="console-badge py-0.5 px-2 text-[10px] font-semibold uppercase">Recomendado</span>
                    </div>
                    <ul class="mt-2.5 flex flex-col gap-1.5">
                      {data.plans.store.features.slice(0, 3).map((feature: string) => (
                        <li class="text-xs sm:text-sm text-[#5f6368] dark:text-[#9aa0a6] flex items-center gap-2">
                          <svg class="w-4 h-4 text-[#188038] dark:text-[#81c995] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                          {feature}
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>

                <div class="text-left md:text-right ml-8 md:ml-0 md:pl-4 border-t md:border-t-0 pt-3 md:pt-0 border-[#dadce0]/60 dark:border-[#2a3443]">
                  <div class="text-2xl font-bold text-[#202124] dark:text-[#f1f3f4] whitespace-nowrap font-display">
                    ${data.plans.store.price} <span class="text-xs font-normal text-[#5f6368] dark:text-[#9aa0a6]">US$/mes</span>
                  </div>
                  <div class="text-[11px] text-[#5f6368] dark:text-[#9aa0a6] mt-0.5">Facturación recurrente mensual</div>
                </div>
              </div>
            </label>
          </div>

          <!-- Console Promo Notice -->
          <div class="mt-6 bg-[#f8f9fa] dark:bg-[#12161f] border border-[#dadce0] dark:border-[#2a3443] rounded-xl p-4 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
            <div class="flex items-center gap-3">
              <div class="w-8 h-8 rounded-lg bg-[#e8f0fe] dark:bg-[#1e2634] text-[#1a73e8] dark:text-[#8ab4f8] flex items-center justify-center font-bold text-sm shrink-0">
                %
              </div>
              <p class="text-xs sm:text-sm text-[#3c4043] dark:text-[#c4c7c5]">
                Pasa a suscripción anual y recibe hasta un <strong class="text-[#1a73e8] dark:text-[#8ab4f8]">20% de descuento</strong> continuo.
              </p>
            </div>
            <button class="btn-ghost-pill h-8 px-3.5 text-xs whitespace-nowrap self-end sm:self-auto">
              Ver opciones
            </button>
          </div>

          <div class="mt-4 flex items-center gap-2 text-xs text-[#5f6368] dark:text-[#9aa0a6]">
            <svg class="w-4 h-4 text-[#188038] dark:text-[#81c995] shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path></svg>
            <span>Incluye actualizaciones automáticas de versión y certificados SSL empresariales sin costo adicional.</span>
          </div>
        </div>

        <!-- Tarjeta 2: Complementos & Addons -->
        <div class="bg-white dark:bg-[#171d26] rounded-[24px] border border-[#dadce0] dark:border-[#2a3443] p-6 sm:p-8 shadow-xs transition-colors duration-200">
          <div class="flex items-center gap-3 mb-6">
            <div class="w-9 h-9 bg-[#e8f0fe] dark:bg-[#1e2634] text-[#1a73e8] dark:text-[#8ab4f8] rounded-lg flex items-center justify-center border border-[#dadce0]/60 dark:border-[#2a3443]">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
              </svg>
            </div>
            <div>
              <h2 class="text-base font-semibold text-[#202124] dark:text-[#f1f3f4]">
                Módulos de Conectividad & WhatsApp
              </h2>
              <p class="text-xs text-[#5f6368] dark:text-[#9aa0a6]">Automatizaciones de mensajes y notificaciones</p>
            </div>
          </div>

          <div class="flex flex-col gap-3">
            {data.addons.whatsapp.options.map((option: any, idx: number) => (
              <label class="relative cursor-pointer group block">
                <input type="radio" name="whatsapp" value={option.id} class="peer sr-only" checked={idx === 0} />
                <div class="rounded-xl border border-[#dadce0] dark:border-[#2a3443] bg-white dark:bg-[#171d26] p-4 hover:border-[#1a73e8]/60 dark:hover:border-[#8ab4f8]/60 peer-checked:border-[#1a73e8] dark:peer-checked:border-[#8ab4f8] peer-checked:bg-[#e8f0fe]/30 dark:peer-checked:bg-[#1a73e8]/10 transition-all">
                  
                  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                    <div class="flex items-start gap-3">
                      <div class="w-4.5 h-4.5 mt-0.5 rounded-full border-2 border-[#dadce0] dark:border-[#5f6368] peer-checked:border-[#1a73e8] dark:peer-checked:border-[#8ab4f8] peer-checked:border-[4px] bg-white dark:bg-[#171d26] transition-all shrink-0"></div>
                      <div>
                        <div class="flex items-center gap-2 flex-wrap">
                          <p class="font-semibold text-sm text-[#202124] dark:text-[#f1f3f4]">{option.name}</p>
                          {idx === 0 && (
                            <span class="console-badge py-0.5 px-2 text-[10px]">Por defecto</span>
                          )}
                        </div>
                        <p class="text-xs text-[#5f6368] dark:text-[#9aa0a6] mt-1">
                          {option.description || "Integración estándar de mensajería y alertas de sistema."}
                        </p>
                      </div>
                    </div>

                    <div class="font-semibold text-sm text-[#202124] dark:text-[#f1f3f4] whitespace-nowrap sm:text-right shrink-0 ml-7 sm:ml-0 font-display">
                      {option.isCustom ? "Personalizado" : `${option.price} US$/mes`}
                    </div>
                  </div>

                </div>
              </label>
            ))}
          </div>
        </div>

      </div>

      <!-- Lado Derecho: Resumen (Sidebar) -->
      <div class="lg:col-span-1 lg:sticky lg:top-24">
        <div class="bg-white dark:bg-[#171d26] rounded-[24px] border border-[#dadce0] dark:border-[#2a3443] p-6 shadow-xs transition-colors duration-200">
          <div class="flex items-center justify-between mb-5 pb-3 border-b border-[#dadce0]/80 dark:border-[#2a3443]">
            <h2 class="text-base font-semibold text-[#202124] dark:text-[#f1f3f4]">
              Resumen de Facturación
            </h2>
            <span class="console-badge text-[10px] py-0.5 px-2">USD</span>
          </div>

          <!-- Plan Breakdown -->
          <div class="mb-5">
            <div class="flex items-center justify-between mb-3">
              <h3 id="summary-plan-name" class="font-semibold text-sm text-[#202124] dark:text-[#f1f3f4]">
                {data.plans.base.name}
              </h3>
              <span class="text-xs text-[#188038] dark:text-[#81c995] font-medium bg-[#e6f4ea] dark:bg-[#188038]/20 px-2 py-0.5 rounded-full">Activo</span>
            </div>
            
            <div class="space-y-3 text-xs sm:text-sm text-[#5f6368] dark:text-[#9aa0a6]">
              <div class="flex justify-between items-center">
                <span>Periodo mensual</span>
                <div class="text-right">
                  <span id="summary-plan-price" class="font-medium text-[#202124] dark:text-[#f1f3f4]">${data.plans.base.price} US$</span>
                </div>
              </div>

              <div class="flex justify-between items-center">
                <span id="summary-whatsapp-name">{data.addons.whatsapp.options[0].name}</span>
                <span id="summary-whatsapp-price" class="font-medium text-[#202124] dark:text-[#f1f3f4]">0 US$</span>
              </div>

              <div class="flex justify-between items-center">
                <span>Certificado SSL & Cloud</span>
                <span class="font-medium text-[#188038] dark:text-[#81c995]">Incluido</span>
              </div>

              <div class="flex justify-between items-center pb-4 border-b border-[#dadce0]/80 dark:border-[#2a3443]">
                <span class="flex items-center gap-1">Impuestos aplicables</span>
                <span class="font-medium text-[#202124] dark:text-[#f1f3f4]">0 US$</span>
              </div>
            </div>
          </div>

          <!-- Total -->
          <div class="flex justify-between items-center mb-6 pt-1">
            <span class="text-base font-semibold text-[#202124] dark:text-[#f1f3f4]">
              Total Mensual
            </span>
            <div class="flex items-baseline gap-1 text-[#1a73e8] dark:text-[#8ab4f8]">
              <span id="summary-total" class="text-3xl font-bold font-display">
                ${data.plans.base.price}
              </span>
              <span class="text-sm font-semibold">US$</span>
            </div>
          </div>

          <!-- Botón primario Google Console -->
          <a
            href="https://app.asyncronix.com/register"
            class="btn-primary w-full text-center h-11 text-sm font-medium mb-5"
          >
            Continuar con el registro
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>

          <!-- Garantía -->
          <div class="text-center pt-2 border-t border-[#dadce0]/80 dark:border-[#2a3443]">
            <p class="text-xs text-[#5f6368] dark:text-[#9aa0a6] flex items-center justify-center gap-1.5 mb-3 font-medium">
              <svg class="w-4 h-4 text-[#188038] dark:text-[#81c995]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
              Garantía de reembolso de 30 días
            </p>
            <p class="text-[11px] text-[#5f6368] dark:text-[#9aa0a6]">
              Cancela o cambia de plan en cualquier momento desde tu panel de control.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  function initPricingCalculator() {
    const dataEl = document.getElementById("pricing-data");
    if (!dataEl) return;

    const data = JSON.parse(dataEl.textContent || "{}");

    const planInputs = document.querySelectorAll('input[name="plan"]');
    const whatsappInputs = document.querySelectorAll('input[name="whatsapp"]');

    const summaryPlanName = document.getElementById("summary-plan-name");
    const summaryPlanPrice = document.getElementById("summary-plan-price");
    const summaryWhatsappName = document.getElementById(
      "summary-whatsapp-name",
    );
    const summaryWhatsappPrice = document.getElementById(
      "summary-whatsapp-price",
    );
    const summaryTotal = document.getElementById("summary-total");

    let currentPlan = data.plans.base;
    let currentWhatsapp = data.addons.whatsapp.options[0];

    function updateSummary() {
      if (summaryPlanName) summaryPlanName.textContent = currentPlan.name;
      if (summaryPlanPrice)
        summaryPlanPrice.textContent = `${currentPlan.price} US$`;

      if (summaryWhatsappName)
        summaryWhatsappName.textContent = currentWhatsapp.name;
      if (summaryWhatsappPrice)
        summaryWhatsappPrice.textContent = currentWhatsapp.isCustom
          ? "0 US$"
          : `${currentWhatsapp.price} US$`;

      const total =
        currentPlan.price +
        (currentWhatsapp.isCustom ? 0 : currentWhatsapp.price);
      if (summaryTotal) summaryTotal.textContent = `${total}`;
    }

    planInputs.forEach((input) => {
      input.addEventListener("change", (e) => {
        const target = e.target as HTMLInputElement;
        if (target.value === data.plans.base.id) currentPlan = data.plans.base;
        if (target.value === data.plans.store.id) currentPlan = data.plans.store;
        updateSummary();
      });
    });

    whatsappInputs.forEach((input) => {
      input.addEventListener("change", (e) => {
        const target = e.target as HTMLInputElement;
        const opt = data.addons.whatsapp.options.find(
          (o: any) => o.id === target.value,
        );
        if (opt) {
          currentWhatsapp = opt;
          updateSummary();
        }
      });
    });
    
    // Initial call
    updateSummary();
  }

  // Ejecutar inicialización al cargar la página y después de transiciones de vista (View Transitions)
  document.addEventListener("astro:page-load", initPricingCalculator);
  
  // Also run on first load if astro:page-load doesn't fire immediately
  if (document.readyState === 'complete' || document.readyState === 'interactive') {
      setTimeout(initPricingCalculator, 0);
  } else {
      document.addEventListener('DOMContentLoaded', initPricingCalculator);
  }
</script>
