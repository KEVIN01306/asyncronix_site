---
const { data } = Astro.props;
---

<section class="py-16 bg-[#f4f5f7] dark:bg-slate-900 relative transition-colors duration-300">
  <div class="max-w-6xl mx-auto px-4 md:px-6">
    <!-- Encabezado como en Hostinger: Tu carrito -->
    <div class="mb-8">
      <h2 class="text-3xl md:text-4xl font-bold text-slate-900 dark:text-white tracking-tight">
        {data.hero.title || "Tu carrito"}
      </h2>
      {data.hero.subtitle && (
        <p class="text-slate-600 dark:text-slate-400 mt-2">{data.hero.subtitle}</p>
      )}
    </div>

    <!-- Pricing State JSON for Client script -->
    <script id="pricing-data" type="application/json" set:html={JSON.stringify(data)} />

    <div class="grid lg:grid-cols-3 gap-8 items-start">
      <!-- Lado Izquierdo: Selección de Planes y Addons -->
      <div class="lg:col-span-2 flex flex-col gap-6">
        
        <!-- Tarjeta 1: Plan Selection (Mimicking the selected plan card) -->
        <div class="bg-white dark:bg-slate-800 rounded-2xl shadow-sm p-6 md:p-8 transition-colors duration-300">
          <div class="flex items-center gap-4 mb-6">
            <div class="w-12 h-12 bg-slate-50 dark:bg-slate-700 rounded-lg flex items-center justify-center text-2xl border border-slate-100 dark:border-slate-600">
              📦
            </div>
            <div>
              <h3 class="text-xl font-bold text-slate-900 dark:text-white">
                {data.calculator.selectPlan}
              </h3>
              <p class="text-sm text-slate-500 dark:text-slate-400">Selecciona el plan que mejor se adapte a ti</p>
            </div>
          </div>

          <div class="flex flex-col gap-4">
            <!-- Base Plan -->
            <label class="relative cursor-pointer group">
              <input type="radio" name="plan" value={data.plans.base.id} class="peer sr-only" checked />
              <div class="rounded-xl border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 p-5 hover:border-slate-300 dark:hover:border-slate-600 peer-checked:border-[#673de6] dark:peer-checked:border-[#825df0] peer-checked:bg-[#f8f6ff] dark:peer-checked:bg-[#673de6]/10 transition-all flex flex-col md:flex-row md:items-center justify-between gap-4">
                
                <div class="flex items-start gap-4">
                  <div class="w-5 h-5 mt-1 rounded-full border-2 border-slate-300 dark:border-slate-600 peer-checked:border-[6px] peer-checked:border-[#673de6] dark:peer-checked:border-[#825df0] transition-all shrink-0"></div>
                  <div>
                    <h4 class="text-lg font-bold text-slate-900 dark:text-white">{data.plans.base.name}</h4>
                    <ul class="mt-2 flex flex-col gap-1.5">
                      {data.plans.base.features.slice(0, 3).map((feature: string) => (
                        <li class="text-sm text-slate-600 dark:text-slate-400 flex items-center gap-2">
                          <svg class="w-4 h-4 text-[#00b67a] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                          {feature}
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>

                <div class="text-right ml-9 md:ml-0 md:pl-4">
                  <div class="text-2xl font-extrabold text-slate-900 dark:text-white whitespace-nowrap">
                    ${data.plans.base.price} <span class="text-sm font-medium text-slate-500 dark:text-slate-400 font-normal">US$/mes</span>
                  </div>
                  <div class="text-xs text-slate-500 mt-1">Se renueva al mismo precio.</div>
                </div>
              </div>
            </label>

            <!-- Store Plan -->
            <label class="relative cursor-pointer group">
              <input type="radio" name="plan" value={data.plans.store.id} class="peer sr-only" />
              <div class="rounded-xl border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 p-5 hover:border-slate-300 dark:hover:border-slate-600 peer-checked:border-[#673de6] dark:peer-checked:border-[#825df0] peer-checked:bg-[#f8f6ff] dark:peer-checked:bg-[#673de6]/10 transition-all flex flex-col md:flex-row md:items-center justify-between gap-4">
                
                <div class="flex items-start gap-4">
                  <div class="w-5 h-5 mt-1 rounded-full border-2 border-slate-300 dark:border-slate-600 peer-checked:border-[6px] peer-checked:border-[#673de6] dark:peer-checked:border-[#825df0] transition-all shrink-0"></div>
                  <div>
                    <div class="flex items-center gap-2">
                      <h4 class="text-lg font-bold text-slate-900 dark:text-white">{data.plans.store.name}</h4>
                      <span class="bg-[#f8f6ff] border border-[#673de6]/20 text-[#673de6] dark:bg-[#673de6]/20 dark:border-[#673de6]/30 dark:text-[#a98eff] text-[10px] font-bold tracking-wider uppercase px-2 py-0.5 rounded">Popular</span>
                    </div>
                    <ul class="mt-2 flex flex-col gap-1.5">
                      {data.plans.store.features.slice(0, 3).map((feature: string) => (
                        <li class="text-sm text-slate-600 dark:text-slate-400 flex items-center gap-2">
                          <svg class="w-4 h-4 text-[#00b67a] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                          {feature}
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>

                <div class="text-right ml-9 md:ml-0 md:pl-4">
                  <div class="text-2xl font-extrabold text-slate-900 dark:text-white whitespace-nowrap">
                    ${data.plans.store.price} <span class="text-sm font-medium text-slate-500 dark:text-slate-400 font-normal">US$/mes</span>
                  </div>
                  <div class="text-xs text-slate-500 mt-1">Se renueva al mismo precio.</div>
                </div>
              </div>
            </label>
          </div>

          <!-- Promo Banner (like Hostinger) -->
          <div class="mt-6 bg-[#1a113a] dark:bg-slate-950 rounded-xl p-4 flex flex-col md:flex-row items-center justify-between gap-4">
            <div class="flex items-center gap-3 text-white">
              <div class="bg-[#00b67a] text-[#1a113a] font-bold w-10 h-10 flex items-center justify-center rounded-lg text-lg shrink-0">
                %
              </div>
              <p class="text-sm font-medium">Pásate a una suscripción de 24 meses y consigue la <strong class="font-bold">mejor oferta</strong>.</p>
            </div>
            <button class="bg-transparent border border-white text-white hover:bg-white hover:text-[#1a113a] text-sm font-bold py-2.5 px-5 rounded-lg transition-colors whitespace-nowrap w-full md:w-auto">
              Obtener oferta
            </button>
          </div>

          <div class="mt-5 flex items-center gap-2 text-sm text-slate-700 dark:text-slate-300">
            <svg class="w-5 h-5 text-[#00b67a]" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path></svg>
            <span>¡Buenas noticias! Obtén un dominio <strong class="font-bold">GRATIS</strong> durante 1 año con este pedido. <span class="text-slate-400 cursor-help">ⓘ</span></span>
          </div>
        </div>

        <!-- Tarjeta 2: Addons (Like Hostinger's Backup card) -->
        <div class="bg-white dark:bg-slate-800 rounded-2xl shadow-sm p-6 md:p-8 transition-colors duration-300">
          <div class="flex flex-col gap-4">
            {data.addons.whatsapp.options.map((option: any, idx: number) => (
              <label class="relative cursor-pointer group">
                <input type="radio" name="whatsapp" value={option.id} class="peer sr-only" checked={idx === 0} />
                <div class="rounded-xl border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 p-5 hover:border-slate-300 dark:hover:border-slate-600 peer-checked:border-[#673de6] dark:peer-checked:border-[#825df0] peer-checked:bg-[#f8f6ff] dark:peer-checked:bg-[#673de6]/10 transition-all">
                  
                  <div class="flex flex-col md:flex-row md:items-start justify-between gap-4">
                    <div class="flex items-start gap-4">
                      <!-- Hostinger checkbox style -->
                      <div class="w-5 h-5 mt-0.5 rounded border-2 border-slate-300 dark:border-slate-600 peer-checked:bg-[#673de6] peer-checked:border-[#673de6] dark:peer-checked:bg-[#825df0] dark:peer-checked:border-[#825df0] text-transparent peer-checked:text-white transition-all shrink-0 flex items-center justify-center">
                        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                      </div>
                      
                      <div>
                        <div class="flex items-center gap-2 flex-wrap">
                          <p class="font-bold text-slate-900 dark:text-white">{option.name}</p>
                          {idx === 0 && (
                            <span class="bg-[#f8f6ff] text-[#673de6] border border-[#673de6]/20 dark:bg-[#673de6]/20 dark:text-[#a98eff] dark:border-[#673de6]/30 text-[10px] font-bold tracking-wider px-2 py-0.5 rounded-full">recomendado</span>
                          )}
                        </div>
                        <p class="text-sm text-slate-500 dark:text-slate-400 mt-2">
                          {option.description || "Haz una backup de los datos todos los días, de modo que siempre sea seguro."}
                        </p>
                      </div>
                    </div>

                    <div class="font-bold text-slate-900 dark:text-white whitespace-nowrap md:text-right shrink-0 ml-9 md:ml-0">
                      {option.isCustom ? "Varía" : `${option.price} US$/mes`}
                    </div>
                  </div>

                </div>
              </label>
            ))}
          </div>
        </div>

      </div>

      <!-- Lado Derecho: Resumen (Sidebar) -->
      <div class="lg:col-span-1 lg:sticky lg:top-32">
        <div class="bg-white dark:bg-slate-800 rounded-2xl shadow-sm p-6 md:p-8 transition-colors duration-300 border border-slate-200 dark:border-slate-700">
          <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-6">
            Resumen del pedido
          </h3>

          <!-- Plan Breakdown -->
          <div class="mb-6">
            <h4 id="summary-plan-name" class="font-bold text-slate-900 dark:text-white mb-4">
              {data.plans.base.name}
            </h4>
            
            <div class="space-y-3.5 text-sm text-slate-600 dark:text-slate-400">
              <div class="flex justify-between items-center">
                <span>Periodo de 1 mes</span>
                <div class="text-right">
                  <span id="summary-plan-price" class="font-semibold text-slate-900 dark:text-white">${data.plans.base.price} US$</span>
                </div>
              </div>

              <div class="flex justify-between items-center">
                <span id="summary-whatsapp-name">{data.addons.whatsapp.options[0].name}</span>
                <span id="summary-whatsapp-price" class="font-semibold text-slate-900 dark:text-white">0 US$</span>
              </div>

              <div class="flex justify-between items-center">
                <span>Nombre de dominio</span>
                <span class="font-semibold text-slate-900 dark:text-white">0 US$</span>
              </div>

              <div class="flex justify-between items-center pb-5 border-b border-slate-200 dark:border-slate-700">
                <span class="flex items-center gap-1">Impuestos <span class="cursor-help text-slate-400 border border-slate-300 rounded-full w-4 h-4 flex items-center justify-center text-[10px]">?</span></span>
                <span class="font-semibold text-slate-900 dark:text-white">0 US$</span>
              </div>
            </div>
          </div>

          <!-- Total -->
          <div class="flex justify-between items-center mb-6">
            <span class="text-lg font-bold text-slate-900 dark:text-white">
              Total
            </span>
            <div class="flex items-center gap-1 bg-[#e0efff] dark:bg-blue-900/30 px-2 py-1 rounded">
              <span id="summary-total" class="text-2xl font-extrabold text-slate-900 dark:text-white">
                ${data.plans.base.price}
              </span>
              <span class="text-lg font-bold text-slate-900 dark:text-white">US$</span>
            </div>
          </div>

          <div class="mb-6">
            <a href="#" class="text-sm font-semibold text-[#673de6] dark:text-[#825df0] hover:text-[#5833c5] transition-colors">
              ¿Tienes un cupón de descuento?
            </a>
          </div>

          <!-- Botón primario estilo Hostinger -->
          <button class="w-full bg-[#673de6] hover:bg-[#5833c5] text-white py-3.5 rounded-xl text-lg font-bold transition-colors mb-6 shadow-sm">
            Continuar
          </button>

          <!-- Garantía -->
          <div class="text-center">
            <p class="text-sm text-slate-600 dark:text-slate-400 flex items-center justify-center gap-2 mb-4">
              <svg class="w-5 h-5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
              Garantía de reembolso de 30 días
            </p>
            
            <!-- Trustpilot -->
            <div class="flex flex-col items-center gap-1.5 mt-2">
              <div class="flex items-center gap-2">
                <span class="font-bold text-slate-900 dark:text-white">Excelente</span>
                <div class="flex gap-1">
                  {[1,2,3,4,5].map(() => (
                    <div class="w-6 h-6 bg-[#00b67a] flex items-center justify-center">
                      <svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                    </div>
                  ))}
                </div>
              </div>
              <p class="text-xs text-slate-600 dark:text-slate-400">
                <a href="#" class="underline hover:text-slate-900 dark:hover:text-white">71.350 opiniones en</a> <span class="text-[#00b67a] font-bold text-sm">★ Trustpilot</span>
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  function initPricingCalculator() {
    const dataEl = document.getElementById("pricing-data");
    if (!dataEl) return;

    const data = JSON.parse(dataEl.textContent || "{}");

    const planInputs = document.querySelectorAll('input[name="plan"]');
    const whatsappInputs = document.querySelectorAll('input[name="whatsapp"]');

    const summaryPlanName = document.getElementById("summary-plan-name");
    const summaryPlanPrice = document.getElementById("summary-plan-price");
    const summaryWhatsappName = document.getElementById(
      "summary-whatsapp-name",
    );
    const summaryWhatsappPrice = document.getElementById(
      "summary-whatsapp-price",
    );
    const summaryTotal = document.getElementById("summary-total");

    let currentPlan = data.plans.base;
    let currentWhatsapp = data.addons.whatsapp.options[0];

    function updateSummary() {
      if (summaryPlanName) summaryPlanName.textContent = currentPlan.name;
      if (summaryPlanPrice)
        summaryPlanPrice.textContent = `${currentPlan.price} US$`;

      if (summaryWhatsappName)
        summaryWhatsappName.textContent = currentWhatsapp.name;
      if (summaryWhatsappPrice)
        summaryWhatsappPrice.textContent = currentWhatsapp.isCustom
          ? "0 US$"
          : `${currentWhatsapp.price} US$`;

      const total =
        currentPlan.price +
        (currentWhatsapp.isCustom ? 0 : currentWhatsapp.price);
      if (summaryTotal) summaryTotal.textContent = `${total}`;
    }

    planInputs.forEach((input) => {
      input.addEventListener("change", (e) => {
        const target = e.target as HTMLInputElement;
        if (target.value === data.plans.base.id) currentPlan = data.plans.base;
        if (target.value === data.plans.store.id) currentPlan = data.plans.store;
        updateSummary();
      });
    });

    whatsappInputs.forEach((input) => {
      input.addEventListener("change", (e) => {
        const target = e.target as HTMLInputElement;
        const opt = data.addons.whatsapp.options.find(
          (o: any) => o.id === target.value,
        );
        if (opt) {
          currentWhatsapp = opt;
          updateSummary();
        }
      });
    });
    
    // Initial call
    updateSummary();
  }

  // Ejecutar inicialización al cargar la página y después de transiciones de vista (View Transitions)
  document.addEventListener("astro:page-load", initPricingCalculator);
  
  // Also run on first load if astro:page-load doesn't fire immediately
  if (document.readyState === 'complete' || document.readyState === 'interactive') {
      setTimeout(initPricingCalculator, 0);
  } else {
      document.addEventListener('DOMContentLoaded', initPricingCalculator);
  }
</script>
