---
const { data } = Astro.props;
---

<section class="py-24 bg-slate-50 relative bg-pattern">
  <div class="max-w-7xl mx-auto px-6">
    <div class="text-center mb-16">
      <h2
        class="text-4xl md:text-5xl font-extrabold text-slate-900 tracking-tight mb-4"
      >
        {data.hero.title}
      </h2>
      <p class="text-xl text-slate-600">
        {data.hero.subtitle}
      </p>
    </div>

    <!-- Pricing State JSON for Client script -->
    <script
      id="pricing-data"
      type="application/json"
      set:html={JSON.stringify(data)}
    />

    <div class="grid lg:grid-cols-3 gap-8">
      <!-- Plans Selection -->
      <div class="lg:col-span-2 flex flex-col gap-8">
        <div class="glass-card p-8">
          <h3 class="text-2xl font-bold text-slate-900 mb-6">
            {data.calculator.selectPlan}
          </h3>

          <div class="grid md:grid-cols-2 gap-6">
            <!-- Base Plan -->
            <label class="relative cursor-pointer group">
              <input
                type="radio"
                name="plan"
                value={data.plans.base.id}
                class="peer sr-only"
                checked
              />
              <div
                class="h-full rounded-2xl border-2 border-slate-200 bg-white p-6 hover:border-[var(--color-primary)]/50 peer-checked:border-[var(--color-primary)] peer-checked:bg-[var(--color-primary)]/5 transition-all"
              >
                <div class="flex justify-between items-center mb-4">
                  <h4 class="text-xl font-bold text-slate-900">
                    {data.plans.base.name}
                  </h4>
                  <div
                    class="w-6 h-6 rounded-full border-2 border-slate-300 peer-checked:border-[var(--color-primary)] peer-checked:bg-[var(--color-primary)] flex items-center justify-center"
                  >
                    <div
                      class="w-2.5 h-2.5 rounded-full bg-white opacity-0 peer-checked:opacity-100 transition-opacity"
                    >
                    </div>
                  </div>
                </div>
                <div class="text-3xl font-extrabold text-slate-900 mb-6">
                  ${data.plans.base.price}
                  <span class="text-base font-medium text-slate-500"
                    >/ mes</span>
                </div>
                <ul class="flex flex-col gap-3">
                  {
                    data.plans.base.features.map((feature: string) => (
                      <li class="flex items-start gap-3 text-sm text-slate-600">
                        <svg
                          class="w-5 h-5 text-[var(--color-primary)] shrink-0"
                          fill="none"
                          viewBox="0 0 24 24"
                          stroke="currentColor"
                          stroke-width="2"
                        >
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M5 13l4 4L19 7"
                          />
                        </svg>
                        {feature}
                      </li>
                    ))
                  }
                </ul>
              </div>
            </label>

            <!-- Store Plan -->
            <label class="relative cursor-pointer group">
              <input
                type="radio"
                name="plan"
                value={data.plans.store.id}
                class="peer sr-only"
              />
              <div
                class="h-full rounded-2xl border-2 border-slate-200 bg-white p-6 hover:border-[var(--color-primary)]/50 peer-checked:border-[var(--color-primary)] peer-checked:bg-[var(--color-primary)]/5 transition-all relative overflow-hidden"
              >
                <div
                  class="absolute top-0 right-0 bg-gradient-to-r from-[var(--color-secondary)] to-[var(--color-primary)] text-white text-xs font-bold px-3 py-1 rounded-bl-lg"
                >
                  POPULAR
                </div>
                <div class="flex justify-between items-center mb-4">
                  <h4 class="text-xl font-bold text-slate-900">
                    {data.plans.store.name}
                  </h4>
                  <div
                    class="w-6 h-6 rounded-full border-2 border-slate-300 peer-checked:border-[var(--color-primary)] peer-checked:bg-[var(--color-primary)] flex items-center justify-center"
                  >
                    <div
                      class="w-2.5 h-2.5 rounded-full bg-white opacity-0 peer-checked:opacity-100 transition-opacity"
                    >
                    </div>
                  </div>
                </div>
                <div class="text-3xl font-extrabold text-slate-900 mb-6">
                  ${data.plans.store.price}
                  <span class="text-base font-medium text-slate-500"
                    >/ mes</span>
                </div>
                <ul class="flex flex-col gap-3">
                  {
                    data.plans.store.features.map((feature: string) => (
                      <li class="flex items-start gap-3 text-sm text-slate-600">
                        <svg
                          class="w-5 h-5 text-[var(--color-primary)] shrink-0"
                          fill="none"
                          viewBox="0 0 24 24"
                          stroke="currentColor"
                          stroke-width="2"
                        >
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M5 13l4 4L19 7"
                          />
                        </svg>
                        {feature}
                      </li>
                    ))
                  }
                </ul>
              </div>
            </label>
          </div>
        </div>

        <!-- Addons -->
        <div class="glass-card p-8">
          <h3 class="text-2xl font-bold text-slate-900 mb-6">
            {data.calculator.selectWhatsapp}
          </h3>

          <div class="flex flex-col gap-4">
            {
              data.addons.whatsapp.options.map((option: any, idx: number) => (
                <label class="relative cursor-pointer group flex items-center justify-between p-4 rounded-xl border border-slate-200 hover:border-[var(--color-primary)]/50 bg-white transition-all has-[:checked]:border-[var(--color-primary)] has-[:checked]:bg-[var(--color-primary)]/5">
                  <div class="flex items-center gap-4">
                    <input
                      type="radio"
                      name="whatsapp"
                      value={option.id}
                      class="w-5 h-5 accent-[var(--color-primary)]"
                      checked={idx === 0}
                    />
                    <div>
                      <p class="font-bold text-slate-900">{option.name}</p>
                      <p class="text-sm text-slate-500">{option.description}</p>
                    </div>
                  </div>
                  <div class="font-bold text-slate-900 whitespace-nowrap">
                    {option.isCustom ? "Varía" : `+$${option.price}`}
                  </div>
                </label>
              ))
            }
          </div>
        </div>
      </div>

      <!-- Summary Sidebar -->
      <div class="lg:col-span-1">
        <div class="glass-card p-8 sticky top-24">
          <h3
            class="text-xl font-bold text-slate-900 mb-6 border-b border-slate-100 pb-4"
          >
            Resumen
          </h3>

          <div class="flex justify-between items-center mb-4 text-slate-600">
            <span id="summary-plan-name">{data.plans.base.name}</span>
            <span id="summary-plan-price" class="font-medium text-slate-900"
              >${data.plans.base.price}</span
            >
          </div>

          <div
            class="flex justify-between items-center mb-6 text-slate-600 pb-6 border-b border-slate-100"
          >
            <span id="summary-whatsapp-name"
              >{data.addons.whatsapp.options[0].name}</span
            >
            <span id="summary-whatsapp-price" class="font-medium text-slate-900"
              >+$0</span
            >
          </div>

          <div class="flex justify-between items-center mb-8">
            <span class="text-lg font-bold text-slate-900"
              >{data.calculator.total}</span
            >
            <span
              id="summary-total"
              class="text-3xl font-extrabold text-[var(--color-primary)]"
              >${data.plans.base.price}</span
            >
          </div>

          <button class="btn-primary w-full py-4 text-lg"
            >Contratar Ahora</button
          >
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const dataEl = document.getElementById("pricing-data");
    if (!dataEl) return;

    const data = JSON.parse(dataEl.textContent || "{}");

    const planInputs = document.querySelectorAll('input[name="plan"]');
    const whatsappInputs = document.querySelectorAll('input[name="whatsapp"]');

    const summaryPlanName = document.getElementById("summary-plan-name");
    const summaryPlanPrice = document.getElementById("summary-plan-price");
    const summaryWhatsappName = document.getElementById(
      "summary-whatsapp-name",
    );
    const summaryWhatsappPrice = document.getElementById(
      "summary-whatsapp-price",
    );
    const summaryTotal = document.getElementById("summary-total");

    let currentPlan = data.plans.base;
    let currentWhatsapp = data.addons.whatsapp.options[0];

    function updateSummary() {
      if (summaryPlanName) summaryPlanName.textContent = currentPlan.name;
      if (summaryPlanPrice)
        summaryPlanPrice.textContent = `$${currentPlan.price}`;

      if (summaryWhatsappName)
        summaryWhatsappName.textContent = currentWhatsapp.name;
      if (summaryWhatsappPrice)
        summaryWhatsappPrice.textContent = currentWhatsapp.isCustom
          ? "Varía"
          : `+$${currentWhatsapp.price}`;

      const total =
        currentPlan.price +
        (currentWhatsapp.isCustom ? 0 : currentWhatsapp.price);
      if (summaryTotal) summaryTotal.textContent = `$${total}`;
    }

    planInputs.forEach((input) => {
      input.addEventListener("change", (e) => {
        const target = e.target as HTMLInputElement;
        if (target.value === "base") currentPlan = data.plans.base;
        if (target.value === "store") currentPlan = data.plans.store;
        updateSummary();
      });
    });

    whatsappInputs.forEach((input) => {
      input.addEventListener("change", (e) => {
        const target = e.target as HTMLInputElement;
        const opt = data.addons.whatsapp.options.find(
          (o: any) => o.id === target.value,
        );
        if (opt) {
          currentWhatsapp = opt;
          updateSummary();
        }
      });
    });
  });
</script>
