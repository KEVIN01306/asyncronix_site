---
interface Props {
  data: {
    title: string;
    subtitle: string;
    nameLabel: string;
    namePlaceholder: string;
    emailLabel: string;
    emailPlaceholder: string;
    phoneLabel: string;
    phonePlaceholder: string;
    companyLabel: string;
    companyPlaceholder: string;
    messageLabel: string;
    messagePlaceholder: string;
    submitButton: string;
    successMessage: string;
  };
}

const { data } = Astro.props;
---

<div
  class="lg:col-span-7 bg-white dark:bg-[#171d26] rounded-[24px] border border-[#dadce0] dark:border-[#2a3443] p-6 sm:p-10 shadow-xs"
>
  <div class="mb-8 pb-4 border-b border-[#dadce0]/80 dark:border-[#2a3443]">
    <h2
      class="text-xl font-semibold text-[#202124] dark:text-[#f1f3f4] mb-1 font-display"
    >
      {data.title}
    </h2>
    <p class="text-xs sm:text-sm text-[#5f6368] dark:text-[#9aa0a6]">
      {data.subtitle}
    </p>
  </div>

  <form id="contact-form" class="space-y-4">
    <div class="grid sm:grid-cols-2 gap-4">
      <div>
        <label
          for="name"
          class="block text-xs font-semibold text-[#3c4043] dark:text-[#c4c7c5] mb-1.5 uppercase tracking-wider"
        >
          {data.nameLabel}
          <span class="text-red-500">*</span>
        </label>
        <input
          type="text"
          id="name"
          name="name"
          required
          placeholder={data.namePlaceholder}
          class="console-input"
        />
      </div>

      <div>
        <label
          for="email"
          class="block text-xs font-semibold text-[#3c4043] dark:text-[#c4c7c5] mb-1.5 uppercase tracking-wider"
        >
          {data.emailLabel}
          <span class="text-red-500">*</span>
        </label>
        <input
          type="email"
          id="email"
          name="email"
          required
          placeholder={data.emailPlaceholder}
          class="console-input"
        />
      </div>
    </div>

    <div class="grid sm:grid-cols-2 gap-4">
      <div>
        <label
          for="phone"
          class="block text-xs font-semibold text-[#3c4043] dark:text-[#c4c7c5] mb-1.5 uppercase tracking-wider"
        >
          {data.phoneLabel}
        </label>
        <input
          type="tel"
          id="phone"
          name="phone"
          placeholder={data.phonePlaceholder}
          class="console-input"
        />
      </div>

      <div>
        <label
          for="company"
          class="block text-xs font-semibold text-[#3c4043] dark:text-[#c4c7c5] mb-1.5 uppercase tracking-wider"
        >
          {data.companyLabel}
        </label>
        <input
          type="text"
          id="company"
          name="company"
          placeholder={data.companyPlaceholder}
          class="console-input"
        />
      </div>
    </div>

    <div>
      <label
        for="message"
        class="block text-xs font-semibold text-[#3c4043] dark:text-[#c4c7c5] mb-1.5 uppercase tracking-wider"
      >
        {data.messageLabel}
        <span class="text-red-500">*</span>
      </label>
      <textarea
        id="message"
        name="message"
        rows="4"
        required
        placeholder={data.messagePlaceholder}
        class="w-full p-3 text-sm text-[#202124] dark:text-[#f1f3f4] bg-white dark:bg-[#12161f] border border-[#dadce0] dark:border-[#2a3443] rounded-lg focus:outline-none focus:border-[#1a73e8] focus:ring-2 focus:ring-[#1a73e8]/20 transition-all resize-none"
      ></textarea>
    </div>

    <div class="pt-2">
      <button
        type="submit"
        class="btn-primary w-full h-11 text-sm font-medium"
      >
        <span>{data.submitButton}</span>
        <svg
          class="w-4 h-4"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M14 5l7 7m0 0l-7 7m7-7H3"
          />
        </svg>
      </button>
    </div>

    <div
      id="form-success"
      class="hidden p-4 rounded-xl bg-[#e6f4ea] dark:bg-[#188038]/20 border border-[#188038]/30 text-[#188038] dark:text-[#81c995] text-xs sm:text-sm font-medium"
    >
      {data.successMessage}
    </div>
  </form>
</div>

<script>
  document.addEventListener("astro:page-load", () => {
    const form = document.getElementById("contact-form");
    const successMsg = document.getElementById("form-success");

    if (form && successMsg) {
      form.addEventListener("submit", (e) => {
        e.preventDefault();
        successMsg.classList.remove("hidden");
        (form as HTMLFormElement).reset();
      });
    }
  });
</script>
