---
const { data, reviews } = Astro.props;
---

<section class="py-20 bg-[#f8f9fa] dark:bg-[#0f1318] relative transition-colors duration-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 relative z-10">
    <div class="text-center max-w-3xl mx-auto mb-14">
      <div class="console-badge mb-3">
        <span>Opiniones de Clientes</span>
      </div>
      <h2 class="text-3xl md:text-4xl font-semibold text-[#202124] dark:text-[#f1f3f4] tracking-tight font-display">
        Testimonios y Casos de Éxito
      </h2>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {reviews.map((review: any) => (
        <div class="console-card-interactive bg-white dark:bg-[#171d26] rounded-[20px] p-7 border border-[#dadce0] dark:border-[#2a3443] flex flex-col justify-between">
          <div>
            <div class="flex items-center gap-1 text-[#f9ab00] mb-4">
              {[1, 2, 3, 4, 5].map(() => (
                <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                </svg>
              ))}
            </div>
            <p class="text-[#3c4043] dark:text-[#c4c7c5] text-sm leading-relaxed mb-6 font-normal">
              "{review.text}"
            </p>
          </div>
          <div class="flex items-center gap-3 pt-4 border-t border-[#dadce0]/60 dark:border-[#2a3443]">
            <img src={review.avatar} alt={review.name} class="w-10 h-10 rounded-full object-cover border border-[#dadce0] dark:border-[#2a3443]" />
            <div>
              <p class="font-semibold text-sm text-[#202124] dark:text-[#f1f3f4]">{review.name}</p>
              <p class="text-xs text-[#1a73e8] dark:text-[#8ab4f8] font-medium">{review.company}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
