---
const { data } = Astro.props;

// Lista dinámica de imágenes del Hero (Puedes agregar o quitar imágenes y el carrusel se adaptará)
const heroImages = [
  "/images/portada_1.png",
  "/images/portada_2.png",
  "/images/portada_3.png",
];

const N = heroImages.length;
const slides = N > 1 ? [...heroImages, heroImages[0]] : heroImages; // Clonamos la primera al final para el loop infinito

let keyframes = "";
if (N > 1) {
  const stepPercent = 100 / N;
  const transitionPercent = 5; // 5% del tiempo total para el movimiento
  for (let i = 0; i <= N; i++) {
    const startHold = i * stepPercent;
    const endHold = startHold + stepPercent - transitionPercent;
    const translateVal = -(i * 100) / (N + 1);

    if (i < N) {
      keyframes += `    ${startHold}%, ${endHold}% { transform: translateX(${translateVal}%); }\n`;
    } else {
      keyframes += `    100% { transform: translateX(${translateVal}%); }\n`;
    }
  }
}
---

<section class="relative pt-24 pb-32 lg:pt-36 lg:pb-40 overflow-hidden">
  <!-- Background Decorations -->
  <div
    class="absolute inset-0 -z-10 bg-slate-50 dark:bg-slate-900 transition-colors duration-300"
  >
  </div>
  <div
    class="absolute top-0 right-0 -z-10 w-[600px] h-[600px] bg-gradient-to-br from-[var(--color-secondary)]/20 to-[var(--color-primary)]/20 rounded-full blur-3xl opacity-60 mix-blend-multiply translate-x-1/2 -translate-y-1/2"
  >
  </div>
  <div
    class="absolute bottom-0 left-0 -z-10 w-[500px] h-[500px] bg-gradient-to-tr from-[var(--color-primary)]/20 to-[var(--color-secondary)]/20 rounded-full blur-3xl opacity-60 mix-blend-multiply -translate-x-1/3 translate-y-1/3"
  >
  </div>

  <div class="max-w-7xl mx-auto px-6 grid lg:grid-cols-2 gap-16 items-center">
    <div class="flex flex-col items-start gap-8 z-10">
      <div
        class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 shadow-sm animate-fade-in transition-colors duration-300"
        style="animation-delay: 0.1s;"
      >
        <span class="flex w-2 h-2 rounded-full bg-[var(--color-primary)]"
        ></span>
        <span class="text-sm font-semibold text-slate-700 dark:text-slate-300"
          >Asyncronix ERP v1.0</span
        >
      </div>

      <h1
        class="text-5xl lg:text-7xl font-extrabold tracking-tight text-slate-900 dark:text-white leading-[1.1] animate-slide-up"
        style="animation-delay: 0.2s;"
      >
        {data.title.split("Asyncronix")[0]}
        <span class="premium-gradient">Asyncronix</span>
      </h1>

      <p
        class="text-xl text-slate-600 dark:text-slate-400 leading-relaxed max-w-xl animate-slide-up"
        style="animation-delay: 0.3s;"
      >
        {data.subtitle}
      </p>

      <div
        class="flex flex-col sm:flex-row gap-4 w-full sm:w-auto animate-slide-up"
        style="animation-delay: 0.4s;"
      >
        <a
          href="https://app.asyncronix.com/register"
          class="btn-primary py-4 px-8 text-lg w-full sm:w-auto text-center"
        >
          {data.ctaPrimary}
        </a>
        <a
          href="#demo"
          class="btn-secondary py-4 px-8 text-lg w-full sm:w-auto text-center"
        >
          {data.ctaSecondary}
        </a>
      </div>
    </div>

    <div
      class="relative mx-auto w-full max-w-[600px] lg:max-w-none lg:w-[115%] lg:-mr-[15%] z-10 animate-fade-in overflow-hidden"
      style="animation-delay: 0.5s;"
    >
      <!-- Contenedor del Carrusel -->
      <div class="relative w-full aspect-[4/3] md:aspect-[16/10]">
        <!-- Wrapper para que toda la pista flote -->
        <div class="absolute top-0 left-0 h-full w-full animate-float">
          <!-- Track del carrusel que se desliza lateralmente -->
          <div
            class={`h-full flex ${N > 1 ? "slider-track" : ""}`}
            style={`width: ${slides.length * 100}%;`}
          >
            {
              slides.map((img, idx) => (
                <div
                  class="h-full relative"
                  style={`width: ${100 / slides.length}%;`}
                >
                  <img
                    src={img}
                    alt={`Asyncronix Dashboard ${idx + 1}`}
                    class="w-full h-full object-contain"
                  />
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Wave Divider -->
  <div class="absolute bottom-0 left-0 w-full overflow-hidden leading-[0]">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 1200 120"
      preserveAspectRatio="none"
      class="relative block w-full h-[40px] md:h-[80px]"
    >
      <path
        d="M321.39,56.44c58-10.79,114.16-30.13,172-41.86,82.39-16.72,168.19-17.73,250.45-.39C823.78,31,906.67,72,985.66,92.83c70.05,18.48,146.53,26.09,214.34,3V120H0V0C6.2,0,12.35,0,18.52,0c85.87,0,172.18,48,252.87,66Z"
        class="fill-white dark:fill-slate-800 transition-colors duration-300"
      ></path>
    </svg>
  </div>
{
  N > 1 && (
    <style
      set:html={`
    @keyframes slideCarousel {
  ${keyframes}
    }
    .slider-track {
      animation: slideCarousel ${N * 6}s infinite ease-in-out;
    }
  `}
    />
  )
}
