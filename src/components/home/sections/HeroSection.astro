---
const { data, lang = "es" } = Astro.props;


// Lista dinámica de imágenes del Hero (Puedes agregar o quitar imágenes y el carrusel se adaptará)
const heroImages = [
  "/images/portada_1.png",
  "/images/portada_2.png",
  "/images/portada_3.png",
];

const N = heroImages.length;
const slides = N > 1 ? [...heroImages, heroImages[0]] : heroImages; // Clonamos la primera al final para el loop infinito

let keyframes = "";
if (N > 1) {
  const stepPercent = 100 / N;
  const transitionPercent = 5; // 5% del tiempo total para el movimiento
  for (let i = 0; i <= N; i++) {
    const startHold = i * stepPercent;
    const endHold = startHold + stepPercent - transitionPercent;
    const translateVal = -(i * 100) / (N + 1);

    if (i < N) {
      keyframes += `    ${startHold}%, ${endHold}% { transform: translateX(${translateVal}%); }\n`;
    } else {
      keyframes += `    100% { transform: translateX(${translateVal}%); }\n`;
    }
  }
}
---

<section class="relative pt-16 pb-24 lg:pt-24 lg:pb-28 overflow-hidden bg-[#f8f9fa] dark:bg-[#0f1318] transition-colors duration-200">
  <!-- Subtle Google Console Background Grid -->
  <div class="absolute inset-0 bg-pattern opacity-60 pointer-events-none"></div>

  <!-- Soft Accent Glow -->
  <div
    class="absolute top-1/4 right-1/4 -z-10 w-[500px] h-[500px] bg-[#e8f0fe] dark:bg-[#1a73e8]/10 rounded-full blur-3xl opacity-70 pointer-events-none"
  ></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 grid lg:grid-cols-2 gap-12 lg:gap-16 items-center relative z-10">
    <div class="flex flex-col items-start gap-6">
      <div class="console-badge animate-fade-in">
        <span class="w-2 h-2 rounded-full bg-[#1a73e8]"></span>
        <span class="font-medium">Asyncronix Platform v1.0</span>
      </div>

      <h1
        class="text-4xl sm:text-5xl lg:text-6xl font-semibold tracking-tight text-[#202124] dark:text-[#f1f3f4] font-display leading-[1.12] animate-slide-up"
      >
        {data.title.split("Asyncronix")[0]}
        <span class="text-[#1a73e8] dark:text-[#8ab4f8]">Asyncronix</span>
      </h1>

      <p
        class="text-lg sm:text-xl text-[#5f6368] dark:text-[#9aa0a6] leading-relaxed max-w-xl animate-slide-up"
        style="animation-delay: 0.1s;"
      >
        {data.subtitle}
      </p>

      <div
        class="flex flex-wrap items-center gap-4 w-full sm:w-auto pt-2 animate-slide-up"
        style="animation-delay: 0.2s;"
      >
        <a
          href="https://app.asyncronix.com/register"
          class="btn-primary"
        >
          {data.ctaPrimary}
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
        <a
          href={`/${lang}/contact`}
          class="btn-secondary"
        >
          {data.ctaSecondary}
        </a>
      </div>

      <!-- Trust highlights -->
      <div class="flex items-center gap-6 pt-4 text-xs font-medium text-[#5f6368] dark:text-[#9aa0a6] border-t border-[#dadce0] dark:border-[#2a3443] w-full">
        <div class="flex items-center gap-1.5">
          <svg class="w-4 h-4 text-[#188038] dark:text-[#81c995]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
          </svg>
          <span>Cloud Nativo</span>
        </div>
        <div class="flex items-center gap-1.5">
          <svg class="w-4 h-4 text-[#188038] dark:text-[#81c995]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
          </svg>
          <span>Seguridad Empresarial</span>
        </div>
        <div class="flex items-center gap-1.5">
          <svg class="w-4 h-4 text-[#188038] dark:text-[#81c995]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
          </svg>
          <span>Soporte 24/7</span>
        </div>
      </div>
    </div>

    <div
      class="relative mx-auto w-full max-w-[580px] lg:max-w-none z-10 animate-fade-in"
      style="animation-delay: 0.3s;"
    >
      <!-- Formal Console Showcase Frame -->
      <div class="bg-white dark:bg-[#171d26] rounded-[24px] border border-[#dadce0] dark:border-[#2a3443] shadow-md dark:shadow-2xl overflow-hidden p-2 bg-[#f8f9fa] dark:bg-[#12161f]">
        <!-- Browser / Console Window Bar -->
        <div class="flex items-center justify-between px-3 py-2 border-b border-[#dadce0]/80 dark:border-[#2a3443] bg-white dark:bg-[#171d26] rounded-t-[18px]">
          <div class="flex items-center gap-1.5">
            <span class="w-2.5 h-2.5 rounded-full bg-[#dadce0] dark:bg-[#3c4043]"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-[#dadce0] dark:bg-[#3c4043]"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-[#dadce0] dark:bg-[#3c4043]"></span>
          </div>
          <div class="flex items-center gap-2 px-3 py-1 rounded-md bg-[#f1f3f4] dark:bg-[#1e2634] text-[11px] text-[#5f6368] dark:text-[#9aa0a6] font-mono">
            <svg class="w-3 h-3 text-[#188038]" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd" /></svg>
            <span>console.asyncronix.com/dashboard</span>
          </div>
          <div class="w-10"></div>
        </div>

        <!-- Carousel Track -->
        <div class="relative w-full aspect-[16/10] overflow-hidden bg-white dark:bg-[#171d26] rounded-b-[18px]">
          <div class="absolute top-0 left-0 h-full w-full animate-float">
            <div
              class={`h-full flex ${N > 1 ? "slider-track" : ""}`}
              style={`width: ${slides.length * 100}%;`}
            >
              {
                slides.map((img, idx) => (
                  <div
                    class="h-full relative"
                    style={`width: ${100 / slides.length}%;`}
                  >
                    <img
                      src={img}
                      alt={`Asyncronix Console Dashboard ${idx + 1}`}
                      class="w-full h-full object-contain p-2"
                    />
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  {
    N > 1 && (
      <style
        set:html={`
    @keyframes slideCarousel {
  ${keyframes}
    }
    .slider-track {
      animation: slideCarousel ${N * 6}s infinite ease-in-out;
    }
  `}
      />
    )
  }
</section>
