---
const { data } = Astro.props;
---

<section class="py-16 px-4 sm:px-6 relative overflow-hidden bg-[#f8f9fa] dark:bg-[#0f1318] transition-colors duration-200">
  <div class="max-w-5xl mx-auto rounded-[24px] p-8 sm:p-14 text-center relative overflow-hidden bg-[#171d26] dark:bg-[#12161f] border border-[#2a3443] shadow-lg">
    <!-- Subtle technical grid -->
    <div class="absolute inset-0 bg-pattern opacity-10 pointer-events-none"></div>

    <div class="relative z-10 flex flex-col items-center">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#1e2634] text-[#8ab4f8] text-xs font-semibold uppercase tracking-wider mb-6 border border-[#2a3443]">
        <span class="w-1.5 h-1.5 rounded-full bg-[#8ab4f8]"></span>
        <span>Empieza hoy mismo</span>
      </div>

      <h2 class="text-3xl sm:text-4xl md:text-5xl font-semibold text-white mb-4 tracking-tight font-display">
        {data.title}
      </h2>
      <p class="text-base sm:text-lg text-[#c4c7c5] mb-8 max-w-xl leading-relaxed font-normal">
        {data.subtitle}
      </p>
      <a href="https://app.asyncronix.com/register" class="btn-primary h-11 px-8 text-base">
        {data.button}
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>
  </div>
</section>

