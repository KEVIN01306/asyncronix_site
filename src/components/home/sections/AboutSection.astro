---
const { data } = Astro.props;
---

<section id="about" class="py-20 bg-white dark:bg-[#171d26] border-y border-[#dadce0] dark:border-[#2a3443] relative overflow-hidden transition-colors duration-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <div class="text-center max-w-3xl mx-auto mb-14">
      <div class="console-badge mb-3">
        <span>Arquitectura & Seguridad</span>
      </div>
      <h2
        class="text-3xl md:text-4xl font-semibold text-[#202124] dark:text-[#f1f3f4] mb-4 tracking-tight font-display"
      >
        {data.title}
      </h2>
      <p class="text-base md:text-lg text-[#5f6368] dark:text-[#9aa0a6] leading-relaxed">
        {data.description}
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-6">
      <div
        class="console-card-interactive p-7 flex flex-col items-start text-left gap-4 bg-[#f8f9fa] dark:bg-[#12161f] border border-[#dadce0] dark:border-[#2a3443] rounded-[20px]"
      >
        <div
          class="w-12 h-12 rounded-xl bg-[#e8f0fe] dark:bg-[#1e2634] border border-[#dadce0]/60 dark:border-[#2a3443] flex items-center justify-center text-[#1a73e8] dark:text-[#8ab4f8]"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg
          >
        </div>
        <div>
          <h3 class="text-lg font-semibold text-[#202124] dark:text-[#f1f3f4] mb-1.5">Seguridad Total</h3>
          <p class="text-sm text-[#5f6368] dark:text-[#9aa0a6] leading-relaxed">Protección de datos de extremo a extremo y copias de seguridad continuas y automáticas.</p>
        </div>
      </div>

      <div
        class="console-card-interactive p-7 flex flex-col items-start text-left gap-4 bg-[#f8f9fa] dark:bg-[#12161f] border border-[#dadce0] dark:border-[#2a3443] rounded-[20px]"
      >
        <div
          class="w-12 h-12 rounded-xl bg-[#e8f0fe] dark:bg-[#1e2634] border border-[#dadce0]/60 dark:border-[#2a3443] flex items-center justify-center text-[#1a73e8] dark:text-[#8ab4f8]"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z"
            ></path>
          </svg>
        </div>
        <div>
          <h3 class="text-lg font-semibold text-[#202124] dark:text-[#f1f3f4] mb-1.5">100% en la Nube</h3>
          <p class="text-sm text-[#5f6368] dark:text-[#9aa0a6] leading-relaxed">Acceso instantáneo desde cualquier navegador sin necesidad de servidores locales ni instalaciones pesadas.</p>
        </div>
      </div>

      <div
        class="console-card-interactive p-7 flex flex-col items-start text-left gap-4 bg-[#f8f9fa] dark:bg-[#12161f] border border-[#dadce0] dark:border-[#2a3443] rounded-[20px]"
      >
        <div
          class="w-12 h-12 rounded-xl bg-[#e8f0fe] dark:bg-[#1e2634] border border-[#dadce0]/60 dark:border-[#2a3443] flex items-center justify-center text-[#1a73e8] dark:text-[#8ab4f8]"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"/></svg
          >
        </div>
        <div>
          <h3 class="text-lg font-semibold text-[#202124] dark:text-[#f1f3f4] mb-1.5">Actualizaciones Constantes</h3>
          <p class="text-sm text-[#5f6368] dark:text-[#9aa0a6] leading-relaxed">Nuevas funcionalidades fiscales y operativas desplegadas automáticamente sin interrupciones.</p>
        </div>
      </div>
    </div>
  </div>
</section>
