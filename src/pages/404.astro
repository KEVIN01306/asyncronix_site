---
import Layout from '../layouts/Layout.astro';
---

<Layout title="404 - Página no encontrada" lang="es" canonicalPath="404">
  <section class="min-h-[70vh] flex flex-col justify-center items-center text-center px-4 py-16 bg-[#f8f9fa] dark:bg-[#0f1318]">
    <div class="bg-white dark:bg-[#171d26] rounded-[24px] border border-[#dadce0] dark:border-[#2a3443] p-10 sm:p-14 max-w-lg w-full shadow-xs">
      <div class="console-badge mb-4">
        <span>Error 404</span>
      </div>
      <h1 class="text-6xl sm:text-7xl font-bold text-[#202124] dark:text-[#f1f3f4] font-display mb-3">404</h1>
      <h2 class="text-xl font-semibold text-[#202124] dark:text-[#f1f3f4] mb-2 font-display">Página no encontrada</h2>
      <p class="text-sm text-[#5f6368] dark:text-[#9aa0a6] mb-8 leading-relaxed">
        El recurso o página que buscas no existe o ha sido movido.
      </p>
      <a 
        href="/es" 
        class="btn-primary"
      >
        Volver al inicio
      </a>
    </div>
  </section>
</Layout>