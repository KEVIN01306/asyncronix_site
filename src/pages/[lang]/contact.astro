---
import Layout from "../../layouts/Layout.astro";
import { actions } from "astro:actions";
import type { Lang } from "../../i18n/config.i18n";
import contactContent from "../../data/contact-content.json";

const lang = Astro.params.lang as Lang;

const fallbackData = (contactContent as any)[lang] || (contactContent as any).es;

const { data: rawData, error } = await Astro.callAction(
    actions.getPageContent,
    {
        lang,
        page: "contact",
    },
);

const data = (rawData && rawData.hero) ? rawData : fallbackData;

if (!data || !data.hero) {
    return Astro.redirect("/404");
}

const title = `Asyncronix | ${data.hero.title}`;
const description = data.hero.subtitle;

const schema = {
    "@context": "https://schema.org",
    "@type": "ContactPage",
    name: title,
    description: description,
    url: `https://asyncronix.com/${lang}/contact`,
    publisher: {
        "@type": "Organization",
        name: "Asyncronix",
    },
};
---

<Layout
    title={title}
    description={description}
    lang={lang}
    canonicalPath="contact"
    schema={schema}
>
    <main
        class="py-14 sm:py-20 bg-[#f8f9fa] dark:bg-[#0f1318] transition-colors duration-200"
    >
        <div class="max-w-7xl mx-auto px-4 sm:px-6">
            <!-- Header Section -->
            <div class="text-center max-w-3xl mx-auto mb-14">
                <div class="console-badge mb-3">
                    <span>{data.hero.badge}</span>
                </div>
                <h1
                    class="text-3xl sm:text-4xl md:text-5xl font-semibold text-[#202124] dark:text-[#f1f3f4] tracking-tight mb-4 font-display"
                >
                    {data.hero.title}
                </h1>
                <p
                    class="text-base sm:text-lg text-[#5f6368] dark:text-[#9aa0a6] leading-relaxed"
                >
                    {data.hero.subtitle}
                </p>
            </div>

            <!-- Two-column: Form & Direct Contact Info -->
            <div
                class="grid lg:grid-cols-12 gap-8 lg:gap-12 items-start max-w-6xl mx-auto"
            >
                <!-- Columna Izquierda: Formulario de Solicitud de Demo / Contacto -->
                <div
                    class="lg:col-span-7 bg-white dark:bg-[#171d26] rounded-[24px] border border-[#dadce0] dark:border-[#2a3443] p-6 sm:p-10 shadow-xs"
                >
                    <div
                        class="mb-8 pb-4 border-b border-[#dadce0]/80 dark:border-[#2a3443]"
                    >
                        <h2
                            class="text-xl font-semibold text-[#202124] dark:text-[#f1f3f4] mb-1 font-display"
                        >
                            {data.form.title}
                        </h2>
                        <p
                            class="text-xs sm:text-sm text-[#5f6368] dark:text-[#9aa0a6]"
                        >
                            {data.form.subtitle}
                        </p>
                    </div>

                    <form id="contact-form" class="space-y-4">
                        <div class="grid sm:grid-cols-2 gap-4">
                            <div>
                                <label
                                    for="name"
                                    class="block text-xs font-semibold text-[#3c4043] dark:text-[#c4c7c5] mb-1.5 uppercase tracking-wider"
                                >
                                    {data.form.nameLabel}
                                    <span class="text-red-500">*</span>
                                </label>
                                <input
                                    type="text"
                                    id="name"
                                    name="name"
                                    required
                                    placeholder={data.form.namePlaceholder}
                                    class="console-input"
                                />
                            </div>

                            <div>
                                <label
                                    for="email"
                                    class="block text-xs font-semibold text-[#3c4043] dark:text-[#c4c7c5] mb-1.5 uppercase tracking-wider"
                                >
                                    {data.form.emailLabel}
                                    <span class="text-red-500">*</span>
                                </label>
                                <input
                                    type="email"
                                    id="email"
                                    name="email"
                                    required
                                    placeholder={data.form.emailPlaceholder}
                                    class="console-input"
                                />
                            </div>
                        </div>

                        <div class="grid sm:grid-cols-2 gap-4">
                            <div>
                                <label
                                    for="phone"
                                    class="block text-xs font-semibold text-[#3c4043] dark:text-[#c4c7c5] mb-1.5 uppercase tracking-wider"
                                >
                                    {data.form.phoneLabel}
                                </label>
                                <input
                                    type="tel"
                                    id="phone"
                                    name="phone"
                                    placeholder={data.form.phonePlaceholder}
                                    class="console-input"
                                />
                            </div>

                            <div>
                                <label
                                    for="company"
                                    class="block text-xs font-semibold text-[#3c4043] dark:text-[#c4c7c5] mb-1.5 uppercase tracking-wider"
                                >
                                    {data.form.companyLabel}
                                </label>
                                <input
                                    type="text"
                                    id="company"
                                    name="company"
                                    placeholder={data.form.companyPlaceholder}
                                    class="console-input"
                                />
                            </div>
                        </div>

                        <div>
                            <label
                                for="message"
                                class="block text-xs font-semibold text-[#3c4043] dark:text-[#c4c7c5] mb-1.5 uppercase tracking-wider"
                            >
                                {data.form.messageLabel}
                                <span class="text-red-500">*</span>
                            </label>
                            <textarea
                                id="message"
                                name="message"
                                rows="4"
                                required
                                placeholder={data.form.messagePlaceholder}
                                class="w-full p-3 text-sm text-[#202124] dark:text-[#f1f3f4] bg-white dark:bg-[#12161f] border border-[#dadce0] dark:border-[#2a3443] rounded-lg focus:outline-none focus:border-[#1a73e8] focus:ring-2 focus:ring-[#1a73e8]/20 transition-all resize-none"
                            ></textarea>
                        </div>

                        <div class="pt-2">
                            <button
                                type="submit"
                                class="btn-primary w-full h-11 text-sm font-medium"
                            >
                                <span>{data.form.submitButton}</span>
                                <svg
                                    class="w-4 h-4"
                                    fill="none"
                                    viewBox="0 0 24 24"
                                    stroke="currentColor"
                                    stroke-width="2"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                                </svg>
                            </button>
                        </div>

                        <div
                            id="form-success"
                            class="hidden p-4 rounded-xl bg-[#e6f4ea] dark:bg-[#188038]/20 border border-[#188038]/30 text-[#188038] dark:text-[#81c995] text-xs sm:text-sm font-medium"
                        >
                            {data.form.successMessage}
                        </div>
                    </form>
                </div>

                <!-- Columna Derecha: Canales Directos e Información de Soporte -->
                <div class="lg:col-span-5 flex flex-col gap-6">
                    <div
                        class="bg-white dark:bg-[#171d26] rounded-[24px] border border-[#dadce0] dark:border-[#2a3443] p-6 sm:p-8 shadow-xs"
                    >
                        <div
                            class="flex items-center gap-3 mb-6 pb-3 border-b border-[#dadce0]/80 dark:border-[#2a3443]"
                        >
                            <div
                                class="w-9 h-9 bg-[#e8f0fe] dark:bg-[#1e2634] text-[#1a73e8] dark:text-[#8ab4f8] rounded-lg flex items-center justify-center border border-[#dadce0]/60 dark:border-[#2a3443]"
                            >
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    width="18"
                                    height="18"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                >
                                    <path
                                        d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"
                                    ></path>
                                </svg>
                            </div>
                            <h2
                                class="text-base font-semibold text-[#202124] dark:text-[#f1f3f4]"
                            >
                                {data.info.title}
                            </h2>
                        </div>

                        <div class="space-y-4 text-xs sm:text-sm">
                            <div class="flex items-start gap-3">
                                <div
                                    class="w-8 h-8 rounded-lg bg-[#f1f3f4] dark:bg-[#1e2634] text-[#5f6368] dark:text-[#9aa0a6] flex items-center justify-center shrink-0"
                                >
                                    <svg
                                        class="w-4 h-4"
                                        fill="none"
                                        viewBox="0 0 24 24"
                                        stroke="currentColor"
                                        stroke-width="2"
                                    >
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                                        ></path>
                                    </svg>
                                </div>
                                <div>
                                    <p
                                        class="text-[11px] text-[#5f6368] dark:text-[#9aa0a6] font-medium"
                                    >
                                        Correo Electrónico
                                    </p>
                                    <a
                                        href={`mailto:${data.info.email}`}
                                        class="font-medium text-[#1a73e8] dark:text-[#8ab4f8] hover:underline"
                                    >
                                        {data.info.email}
                                    </a>
                                </div>
                            </div>

                            <div class="flex items-start gap-3">
                                <div
                                    class="w-8 h-8 rounded-lg bg-[#f1f3f4] dark:bg-[#1e2634] text-[#5f6368] dark:text-[#9aa0a6] flex items-center justify-center shrink-0"
                                >
                                    <svg
                                        class="w-4 h-4"
                                        fill="none"
                                        viewBox="0 0 24 24"
                                        stroke="currentColor"
                                        stroke-width="2"
                                    >
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"
                                        ></path>
                                    </svg>
                                </div>
                                <div>
                                    <p
                                        class="text-[11px] text-[#5f6368] dark:text-[#9aa0a6] font-medium"
                                    >
                                        Horario de Atención
                                    </p>
                                    <p
                                        class="text-[#202124] dark:text-[#f1f3f4] font-medium"
                                    >
                                        {data.info.hours}
                                    </p>
                                </div>
                            </div>

                            <div class="flex items-start gap-3">
                                <div
                                    class="w-8 h-8 rounded-lg bg-[#f1f3f4] dark:bg-[#1e2634] text-[#5f6368] dark:text-[#9aa0a6] flex items-center justify-center shrink-0"
                                >
                                    <svg
                                        class="w-4 h-4"
                                        fill="none"
                                        viewBox="0 0 24 24"
                                        stroke="currentColor"
                                        stroke-width="2"
                                    >
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                                        ></path>
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
                                        ></path>
                                    </svg>
                                </div>
                                <div>
                                    <p
                                        class="text-[11px] text-[#5f6368] dark:text-[#9aa0a6] font-medium"
                                    >
                                        Ubicación & Cobertura
                                    </p>
                                    <p
                                        class="text-[#202124] dark:text-[#f1f3f4] font-medium"
                                    >
                                        {data.info.location}
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Enterprise Helpdesk Card -->
                    <div
                        class="bg-white dark:bg-[#171d26] rounded-[24px] border border-[#dadce0] dark:border-[#2a3443] p-6 sm:p-8 shadow-xs"
                    >
                        <div class="flex items-center gap-2 mb-2">
                            <span
                                class="w-2 h-2 rounded-full bg-[#188038] dark:bg-[#81c995]"
                            ></span>
                            <h3
                                class="text-sm font-semibold text-[#202124] dark:text-[#f1f3f4]"
                            >
                                {data.info.supportTitle}
                            </h3>
                        </div>
                        <p
                            class="text-xs text-[#5f6368] dark:text-[#9aa0a6] leading-relaxed mb-4"
                        >
                            {data.info.supportText}
                        </p>
                        <a
                            href="https://app.asyncronix.com/"
                            class="btn-secondary w-full text-center h-9 text-xs font-semibold"
                        >
                            Ir a la consola de soporte
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </main>
</Layout>

<script>
    document.addEventListener("astro:page-load", () => {
        const form = document.getElementById("contact-form");
        const successMsg = document.getElementById("form-success");

        if (form && successMsg) {
            form.addEventListener("submit", (e) => {
                e.preventDefault();
                successMsg.classList.remove("hidden");
                (form as HTMLFormElement).reset();
            });
        }
    });
</script>
