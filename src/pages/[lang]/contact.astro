---
import Layout from "../../layouts/Layout.astro";
import { actions } from "astro:actions";
import type { Lang } from "../../i18n/config.i18n";
import contactContent from "../../data/contact-content.json";

// Contact Components
import ContactHeroSection from "../../components/contact/sections/ContactHeroSection.astro";
import ContactForm from "../../components/contact/sections/ContactForm.astro";
import ContactInfo from "../../components/contact/sections/ContactInfo.astro";

const lang = Astro.params.lang as Lang;

const fallbackData =
    (contactContent as any)[lang] || (contactContent as any).es;

const { data: rawData } = await Astro.callAction(
    actions.getPageContent,
    {
        lang,
        page: "contact",
    },
);

const data = rawData && rawData.hero ? rawData : fallbackData;

if (!data || !data.hero) {
    return Astro.redirect("/404");
}

const title = `Asyncronix | ${data.hero.title}`;
const description = data.hero.subtitle;
const contactUrl = `https://asyncronix.com/${lang}/contact`;
const schema = {
    "@context": "https://schema.org",
    "@graph": [
        {
            "@type": "ContactPage",
            "@id": `${contactUrl}#webpage`,
            url: contactUrl,
            name: title,
            description: description,
            isPartOf: {
                "@type": "WebSite",
                "@id": "https://asyncronix.com/#website",
            },
            about: {
                "@id": "https://asyncronix.com/#organization",
            },
        },
        {
            "@type": "Organization",
            "@id": "https://asyncronix.com/#organization",
            name: "Asyncronix",
            url: "https://asyncronix.com",
            logo: "https://asyncronix.com/icon.webp",
            contactPoint: [
                {
                    "@type": "ContactPoint",
                    contactType: "customer support",
                    email: "soporte@asyncronix.com",
                    telephone: "+502-0000-0000",
                    availableLanguage: ["es", "en"],
                    url: contactUrl,
                },
                {
                    "@type": "ContactPoint",
                    contactType: "sales",
                    email: "ventas@asyncronix.com",
                    availableLanguage: ["es", "en"],
                },
            ],
        },
    ],
};
---

<Layout
    title={title}
    description={description}
    lang={lang}
    canonicalPath="contact"
    schema={schema}
>
    <main
        class="py-14 sm:py-20 bg-[#f8f9fa] dark:bg-[#0f1318] transition-colors duration-200"
    >
        <div class="max-w-7xl mx-auto px-4 sm:px-6">
            <!-- Header / Hero Section -->
            <ContactHeroSection data={data.hero} />

            <!-- Two-column: Form & Direct Contact Info -->
            <div
                class="grid lg:grid-cols-12 gap-8 lg:gap-12 items-start max-w-6xl mx-auto"
            >
                <ContactForm data={data.form} />
                <ContactInfo data={data.info} />
            </div>
        </div>
    </main>
</Layout>
