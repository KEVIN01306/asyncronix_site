---
import Layout from "../../layouts/Layout.astro";
import { actions } from "astro:actions";
import type { Lang } from "../../i18n/config.i18n";

const lang = Astro.params.lang as Lang;
const { data: rawData, error } = await Astro.callAction(
    actions.getPageContent,
    {
        lang,
        page: "privacy",
    },
);
const data = rawData as any;

if (error || !data) {
    return Astro.redirect("/404");
}

const title = `Asyncronix | ${data.title}`;

const schema = {
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: title,
    url: `https://asyncronix.com/${lang}/privacy`,
    publisher: {
        "@type": "Organization",
        name: "Asyncronix",
    },
};
---

<Layout title={title} lang={lang} canonicalPath="privacy" schema={schema}>
    <main
        class="py-16 bg-[#f8f9fa] dark:bg-[#0f1318] transition-colors duration-200"
    >
        <div class="max-w-3xl mx-auto px-4 sm:px-6">
            <div class="bg-white dark:bg-[#171d26] rounded-[24px] border border-[#dadce0] dark:border-[#2a3443] p-8 sm:p-12 shadow-xs">
                <div class="console-badge mb-3">
                    <span>Documentación Legal</span>
                </div>
                <h1
                    class="text-3xl sm:text-4xl font-semibold text-[#202124] dark:text-[#f1f3f4] tracking-tight mb-2 font-display"
                >
                    {data.title}
                </h1>
                <p class="text-xs text-[#5f6368] dark:text-[#9aa0a6] mb-8 pb-4 border-b border-[#dadce0]/80 dark:border-[#2a3443]">
                    {data.lastUpdated}
                </p>
                <div
                    class="text-sm leading-relaxed text-[#3c4043] dark:text-[#c4c7c5] space-y-4"
                >
                    <p>{data.content}</p>
                </div>
            </div>
        </div>
    </main>
</Layout>
