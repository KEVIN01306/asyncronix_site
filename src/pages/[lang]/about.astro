---
import Layout from "../../layouts/Layout.astro";
import { actions } from "astro:actions";
import type { Lang } from "../../i18n/config.i18n";

// Sections
import AboutHeroSection from "../../components/about/sections/AboutHeroSection.astro";
import TeamValuesSection from "../../components/about/sections/TeamValuesSection.astro";

const lang = Astro.params.lang as Lang;

const { data, error: aboutError } = await Astro.callAction(
    actions.getPageContent,
    {
        lang,
        page: "about",
    },
);
const aboutData = data as any;

if (aboutError || !aboutData || !aboutData.hero) {
    return Astro.redirect("/404");
}

const title = `Asyncronix | ${aboutData.hero.title}`;
const description = aboutData.hero.subtitle;

const schema = {
    "@context": "https://schema.org",
    "@type": "AboutPage",
    "name": title,
    "description": description,
    "url": `https://asyncronix.com/${lang}/about`,
    "publisher": {
        "@type": "Organization",
        "name": "Asyncronix"
    }
};
---

<Layout title={title} description={description} lang={lang} canonicalPath="about" schema={schema}>
    <main>
        <AboutHeroSection data={aboutData.hero} />
        <TeamValuesSection team={aboutData.team} mission={aboutData.mission} />
    </main>
</Layout>
