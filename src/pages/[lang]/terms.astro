---
import Layout from "../../layouts/Layout.astro";
import { actions } from "astro:actions";
import type { Lang } from "../../i18n/config.i18n";

const lang = Astro.params.lang as Lang;
const { data: rawData, error } = await Astro.callAction(
    actions.getPageContent,
    {
        lang,
        page: "terms",
    },
);
const data = rawData as any;

if (error || !data) {
    return Astro.redirect("/404");
}

const title = `Asyncronix | ${data.title}`;

const schema = {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": title,
    "url": `https://asyncronix.com/${lang}/terms`,
    "publisher": {
        "@type": "Organization",
        "name": "Asyncronix"
    }
};
---

<Layout title={title} lang={lang} canonicalPath="terms" schema={schema}>
    <main class="py-24 bg-white dark:bg-slate-900 bg-pattern transition-colors duration-300">
        <div class="max-w-3xl mx-auto px-6">
            <h1
                class="text-4xl md:text-5xl font-extrabold text-slate-900 dark:text-white tracking-tight mb-4"
            >
                {data.title}
            </h1>
            <p class="text-sm text-slate-500 dark:text-slate-400 mb-12">
                {data.lastUpdated}
            </p>
            <div class="prose prose-slate dark:prose-invert prose-lg max-w-none text-slate-600 dark:text-slate-300">
                <p>{data.content}</p>
                <!-- Add more static content as needed here later -->
                <p class="mt-8 italic opacity-75">
                    Nota: Esta página está preparada para recibir más contenido
                    dinámico en el futuro.
                </p>
            </div>
        </div>
    </main>
</Layout>
