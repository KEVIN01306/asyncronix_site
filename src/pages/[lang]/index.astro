---
import Layout from "../../layouts/Layout.astro";
import { actions } from "astro:actions";
import type { Lang } from "../../i18n/config.i18n";

// Sections
import HeroSection from "../../components/home/sections/HeroSection.astro";
import AboutSection from "../../components/home/sections/AboutSection.astro";
import FeaturesSection from "../../components/home/sections/FeaturesSection.astro";
import BenefitsSection from "../../components/home/sections/BenefitsSection.astro";
import TestimonialsSection from "../../components/home/sections/TestimonialsSection.astro";
import FAQSection from "../../components/home/sections/FAQSection.astro";

const lang = Astro.params.lang as Lang;

const { data, error: homeError } = await Astro.callAction(
    actions.getPageContent,
    { lang, page: "home" },
);
const homeData = data as any;
const { data: reviewsData } = await Astro.callAction(
    actions.getReviews,
    { lang },
);

if (homeError || !homeData || !homeData.hero) {
    return Astro.redirect("/404");
}

const title = `Asyncronix | ${homeData.hero.title}`;
const description = homeData.hero.subtitle;

const schema = {
    "@context": "https://schema.org",
    "@graph": [
        {
            "@type": "SoftwareApplication",
            "@id": "https://asyncronix.com/#software",
            name: "Asyncronix",
            url: "https://asyncronix.com",
            operatingSystem: "All, Web",
            applicationCategory: "BusinessApplication",
            description: description,
            offers: {
                "@type": "Offer",
                price: "0",
                priceCurrency: "USD",
            },
        },
        {
            "@type": "Organization",
            "@id": "https://asyncronix.com/#organization",
            name: "Asyncronix",
            url: "https://asyncronix.com",
            logo: "https://asyncronix.com/icon.webp",
        },
        // Si homeData.faq existe y tiene preguntas/respuestas:
        ...(homeData.faq && homeData.faq.items
            ? [
                  {
                      "@type": "FAQPage",
                      mainEntity: homeData.faq.items.map((item: any) => ({
                          "@type": "Question",
                          name: item.question,
                          acceptedAnswer: {
                              "@type": "Answer",
                              text: item.answer,
                          },
                      })),
                  },
              ]
            : []),
    ],
};
---

<Layout
    title={title}
    description={description}
    lang={lang}
    canonicalPath=""
    schema={schema}
>
    <main>
        <HeroSection data={homeData.hero} lang={lang} />
        <AboutSection data={homeData.about} />
        <FeaturesSection data={homeData.features} />
        <BenefitsSection data={homeData.benefits} />
        {
            reviewsData && reviewsData.length > 0 && (
                <TestimonialsSection data={homeData} reviews={reviewsData} />
            )
        }
        <FAQSection data={homeData.faq} />
    </main>
</Layout>
