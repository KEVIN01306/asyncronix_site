---
import type { Lang } from "../i18n/config.i18n";
import { LANGUAGES } from "../i18n/config.i18n";
import Navbar from "../components/common/Navbar.astro";
import Footer from "../components/common/Footer.astro";
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";

interface Props {
	title: string;
	lang: Lang;
	description?: string;
	image?: string;
	schema?: object;
	canonicalPath?: string;
}

const {
	title,
	lang,
	description = "Asyncronix - Soluciones profesionales de software.",
	image = "/icon.webp",
	schema,
	canonicalPath,
} = Astro.props;

const baseUrl = "https://asyncronix.com";

const baseRoute =
	canonicalPath !== undefined
		? canonicalPath
		: Astro.url.pathname.replace(/^\/[a-z]{2}(\/|$)/, "");
const cleanRoute = baseRoute.startsWith("/") ? baseRoute.slice(1) : baseRoute;

const canonicalURL = new URL(
	`/${lang}${cleanRoute ? `/${cleanRoute}` : ""}`,
	baseUrl,
).href;
const socialImageURL = new URL(image, Astro.url.origin).href;

const alternateLinks = Object.keys(LANGUAGES).map((l) => ({
	lang: l,
	url: new URL(`/${l}${cleanRoute ? `/${cleanRoute}` : ""}`, baseUrl).href,
}));
const defaultLink = new URL(`/es${cleanRoute ? `/${cleanRoute}` : ""}`, baseUrl)
	.href;
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#ffffff" />
		<link rel="icon" type="image/webp" href="/icon.webp" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="robots" content="index, follow" />

		<link rel="canonical" href={canonicalURL} />
		{
			alternateLinks.map(({ lang: l, url }) => (
				<link rel="alternate" hreflang={l} href={url} />
			))
		}
		<link rel="alternate" hreflang="x-default" href={defaultLink} />

		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:site_name" content="Asyncronix" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={socialImageURL} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={title} />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:url" content={canonicalURL} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={socialImageURL} />

		<meta name="apple-mobile-web-app-title" content="Asyncronix" />
		<meta name="application-name" content="Asyncronix" />

		<ClientRouter />

		{
			schema && (
				<script
					type="application/ld+json"
					set:html={JSON.stringify(schema)}
				/>
			)
		}

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Roboto:wght@400;500;700&display=swap"
			rel="stylesheet"
		/>

		<!-- Dark mode inline script to prevent FOUC -->
		<script is:inline>
			const setDarkMode = () => {
				const theme = (() => {
					if (
						typeof localStorage !== "undefined" &&
						localStorage.getItem("theme")
					) {
						return localStorage.getItem("theme");
					}
					if (
						window.matchMedia("(prefers-color-scheme: dark)")
							.matches
					) {
						return "dark";
					}
					return "light";
				})();

				if (theme === "light") {
					document.documentElement.classList.remove("dark");
				} else {
					document.documentElement.classList.add("dark");
				}
			};

			setDarkMode();
			document.addEventListener("astro:after-swap", setDarkMode);
		</script>
	</head>
	<body
		class="bg-[#f8f9fa] text-[#202124] dark:bg-[#0f1318] dark:text-[#f1f3f4] antialiased min-h-screen flex flex-col transition-colors duration-200 selection:bg-[#e8f0fe] selection:text-[#1a73e8] dark:selection:bg-[#1e2634] dark:selection:text-[#8ab4f8]"
	>
		<Navbar lang={lang} />
		<main class="flex-1">
			<slot />
		</main>
		<Footer lang={lang} />
	</body>
</html>

<style is:global>
	html {
		scroll-behavior: smooth;
	}
	::view-transition-old(root),
	::view-transition-new(root) {
		animation-duration: 0.4s;
	}
</style>
